            "Source.__next__:1",
        ],
        changed=["arg0"],
    )
    c.raises(
        "str.format", "missing_attribute",
        "receiver = '{0.missing}'\narg0 = object()",
        "receiver.format(arg0)", "AttributeError",
    )
    c.raises(
        "str.format", "format_hook_raises",
        """
class Value:
