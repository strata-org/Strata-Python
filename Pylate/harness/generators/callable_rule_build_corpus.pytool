arg0 = Source()
""",
        "list(arg0)", "RuntimeError",
        categories=["hook_effect", "mutation_phase"],
        events=["Source.__iter__", "Source.__next__:0", "Source.__next__:1"],
        changed=["arg0"],
    )
    c.raises(
        "set", "unhashable_element",
        "arg0 = [1, []]", "set(arg0)", "TypeError",
        categories=["mutation_phase"],
    )
    c.raises(
        "dict", "bad_pair_arity",
        "arg0 = [('a', 1), ('bad',)]", "dict(arg0)", "ValueError",
        categories=["mutation_phase"],
    )
    c.raises(
        "dict", "unhashable_key",
        "arg0 = [('a', 1), ([], 2)]", "dict(arg0)", "TypeError",
        categories=["mutation_phase"],
    )

    # Mixed abstract values are represented by their concrete witnesses.
    c.mixed(
        "list.insert", "mixed_int_or_str_index",
        [normal["list.insert"], witnesses["list_insert_type"]],
        ["raise:builtins.TypeError", "return:builtins.NoneType"],
        note="Abstract index tag set int|str must retain both paths.",
    )
    c.mixed(
        "list.extend", "mixed_iterable_or_int",
        [normal["list.extend"], witnesses["list_extend_type"]],
        ["raise:builtins.TypeError", "return:builtins.NoneType"],
        note="Iterable and non-iterable alternatives start from one state.",
    )
    c.mixed(
        "list.pop", "mixed_empty_or_nonempty",
        [normal["list.pop"], witnesses["list_pop_empty"]],
        ["raise:builtins.IndexError", "return:builtins.int"],
        note="Top emptiness must retain success and IndexError.",
    )
    c.mixed(
        "set.add", "mixed_hashable_or_unhashable",
        [normal["set.add"], witnesses["set_add_type"]],
        ["raise:builtins.TypeError", "return:builtins.NoneType"],
        note="Hashability splitting precedes insertion.",
    )
    c.mixed(
        "set.pop", "mixed_empty_or_nonempty",
        [normal["set.pop"], witnesses["set_pop_empty"]],
        ["raise:builtins.KeyError", "return:builtins.int"],
        note="Top emptiness must retain success and KeyError.",
    )
    c.mixed(
        "dict.get", "mixed_hashable_or_unhashable_key",
        [normal["dict.get"], witnesses["dict_get_type"]],
        ["raise:builtins.TypeError", "return:builtins.int"],
        note="Every key-tag alternative starts from the pre-hash state.",
    )
    c.mixed(
        "dict.popitem", "mixed_empty_or_nonempty",
        [normal["dict.popitem"], witnesses["dict_popitem_empty"]],
        ["raise:builtins.KeyError", "return:builtins.tuple"],
        note="Top dictionary emptiness retains both outcomes.",
    )
    c.mixed(
        "str.strip", "mixed_none_or_int_chars",
        [normal["str.strip"], witnesses["str_strip_type"]],
        ["raise:builtins.TypeError", "return:builtins.str"],
        note="Optional string contract splits valid and invalid tags.",
    )
    c.mixed(
        "len", "mixed_sized_or_int",
        [normal["len"], witnesses["len_type"]],
        ["raise:builtins.TypeError", "return:builtins.int"],
        note="Sized and unsized receiver alternatives are both retained.",
    )
    c.mixed(
        "range", "mixed_int_or_str_operand",
        [normal["range"], witnesses["range_type"]],
        ["raise:builtins.TypeError", "return:builtins.range"],
        note="SupportsIndex alternatives split before allocation.",
    )
    c.mixed(
        "iter", "mixed_iterable_or_int",
        [normal["iter"], witnesses["iter_type"]],
        ["raise:builtins.TypeError", "return:builtins.list_iterator"],
        note="Iteration protocol alternatives retain the non-iterable error.",
    )
    c.mixed(
        "next", "mixed_iterator_or_int",
        [normal["next"], witnesses["next_type"]],
        ["raise:builtins.TypeError", "return:builtins.int"],
        note="Iterator and non-iterator tags remain separate.",
    )
    c.mixed(
        "gen.send", "mixed_suspended_or_created",
        [normal["gen.send"], witnesses["gen_send_created"]],
        ["raise:builtins.TypeError", "return:builtins.int"],
        note="Generator suspension state controls initial non-None send.",
    )

    return witnesses


def inventory() -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for receiver, names in METHODS.items():
        for name in names:
            key = f"{receiver}.{name}"
            rows.append(
                {
                    "key": key,
                    "kind": "method",
                    "receiver": receiver,
                    "name": name,
                    "family": receiver,
                    "formerly_opaque": key in FORMERLY_OPAQUE,
                }
            )
    for name in FUNCTIONS:
        rows.append(
            {
                "key": name,
                "kind": "function",
                "name": name,
                "family": "builtin",
                "formerly_opaque": False,
            }
        )
    return sorted(rows, key=lambda row: row["key"])


def coverage_rows(
    rule_inventory: list[dict[str, Any]],
    scenarios: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    by_rule: dict[str, dict[str, list[str]]] = {}
    for row in rule_inventory:
        by_rule[row["key"]] = {dimension: [] for dimension in DIMENSIONS}
    for scenario in scenarios:
        for category in scenario["categories"]:
            by_rule[scenario["rule_key"]][category].append(scenario["id"])

    rows: list[dict[str, Any]] = []
    for rule in rule_inventory:
        key = rule["key"]
        for dimension in DIMENSIONS:
            ids = sorted(by_rule[key][dimension])
            if ids:
                status = "covered"
                reason = None
            elif dimension in ("inventory", "normal", "cpython_evidence"):
                status = "missing"
                reason = "required for every RuleKey"
            elif dimension == "mixed_abstract":
                status = "gap"
                reason = "requires V2 Flow test plus concrete witness alternatives"
            else:
                status = "gap"
                reason = "catalog applicability must be discharged or marked inapplicable"
            row = {
                "rule_key": key,
                "dimension": dimension,
                "status": status,
                "scenarios": ids,
            }
            if reason:
                row["reason"] = reason
            rows.append(row)
    return rows


def build() -> dict[str, Any]:
    c = Corpus()
    normal = add_normal_scenarios(c)
    add_failure_and_effect_scenarios(c, normal)
    rules = inventory()
    return {
        "schema_version": 1,
        "target": {
            "implementation": "CPython",
            "major": 3,
            "minor": 13,
        },
        "dimensions": DIMENSIONS,
        "catalog_exception_classes": CATALOG_EXCEPTION_CLASSES,
        "inventory": rules,
        "scenarios": sorted(c.scenarios, key=lambda row: row["id"]),
        "coverage": coverage_rows(rules, c.scenarios),
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        default=pathlib.Path(__file__).with_name(
            "callable_rule_scenarios.json"
        ),
    )
    args = parser.parse_args()
    matrix = build()
    args.output.write_text(
        json.dumps(matrix, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(
        f"wrote {len(matrix['inventory'])} RuleKeys and "
        f"{len(matrix['scenarios'])} scenarios to {args.output}"
    )


if __name__ == "__main__":
    main()
