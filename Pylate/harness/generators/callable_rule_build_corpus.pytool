""",
        "invoke()", "return", "builtins.tuple",
        categories=["alias_emptiness", "mutation_phase"],
        changed=["receiver"],
    )
    c.concrete(
        "dict.values", "live_view_observes_mutation",
        """
receiver = {'a': 1}
