""",
        "receiver.throw(arg0)", "ValueError",
        categories=["mutation_phase"], changed=["receiver"],
    )

    # Builtin protocol functions and constructor consumption.
    remember("len_type", c.raises(
        "len", "unsized", "arg0 = 1", "len(arg0)", "TypeError",
    ))
    c.raises(
        "len", "negative_hook_result",
        """
