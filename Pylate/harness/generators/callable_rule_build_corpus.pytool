    for method in ("index", "rindex"):
        c.raises(
            f"str.{method}", "missing",
            "receiver = 'abc'\narg0 = 'z'",
            f"receiver.{method}(arg0)", "ValueError",
        )
    for method in ("split", "rsplit"):
        c.raises(
            f"str.{method}", "empty_separator",
            "receiver = 'abc'\narg0 = ''",
            f"receiver.{method}(arg0)", "ValueError",
        )
    c.raises(
        "str.splitlines", "keepends_truth_hook_raises",
        """
