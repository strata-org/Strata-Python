#!/usr/bin/env python3
"""Build the machine-readable callable-rule conformance matrix.

This file contains corpus declarations only.  The independent CPython runner
loads the emitted JSON and executes each concrete witness in a fresh namespace.
Abstract mixed-value cases refer to two or more concrete witnesses because
CPython cannot directly execute an abstract union.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
from typing import Any


METHODS: dict[str, list[str]] = {
    "list": [
        "append", "clear", "copy", "count", "extend", "index", "insert",
        "pop", "remove", "reverse", "sort",
    ],
    "dict": [
        "clear", "copy", "fromkeys", "get", "items", "keys", "pop",
        "popitem", "setdefault", "update", "values",
    ],
    "set": [
        "add", "clear", "copy", "difference", "difference_update",
        "discard", "intersection", "intersection_update", "isdisjoint",
        "issubset", "issuperset", "pop", "remove",
        "symmetric_difference", "symmetric_difference_update", "union",
        "update",
    ],
    "tuple": ["count", "index"],
    "range": ["count", "index"],
    "gen": ["close", "send", "throw"],
    "str": [
        "capitalize", "casefold", "center", "count", "encode", "endswith",
        "expandtabs", "find", "format", "format_map", "index", "isalnum",
        "isalpha", "isascii", "isdecimal", "isdigit", "isidentifier",
        "islower", "isnumeric", "isprintable", "isspace", "istitle",
        "isupper", "join", "ljust", "lower", "lstrip", "maketrans",
        "partition", "removeprefix", "removesuffix", "replace", "rfind",
        "rindex", "rjust", "rpartition", "rsplit", "rstrip", "split",
        "splitlines", "startswith", "strip", "swapcase", "title",
        "translate", "upper", "zfill",
    ],
}

FUNCTIONS = [
    "len", "range", "print", "isinstance", "next", "iter", "str", "repr",
    "list", "dict", "set", "tuple",
]

FORMERLY_OPAQUE = {
    "dict.popitem",
    "set.difference_update",
    "set.intersection_update",
    "set.symmetric_difference_update",
    "str.encode",
    "str.format_map",
    "str.maketrans",
    "str.partition",
    "str.rpartition",
    "str.translate",
    "gen.close",
    "gen.send",
    "gen.throw",
}

DIMENSIONS = [
    "inventory",
    "normal",
    "invalid",
    "mixed_abstract",
    "hook_effect",
    "mutation_phase",
    "alias_emptiness",
    "cpython_evidence",
]

CATALOG_EXCEPTION_CLASSES = [
    "AttributeError",
    "IndexError",
    "KeyError",
    "LookupError",
    "MemoryError",
    "RuntimeError",
    "StopIteration",
    "TypeError",
    "UnicodeEncodeError",
    "ValueError",
]


def scenario_id(rule_key: str, label: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", f"{rule_key}_{label}".lower()).strip("_")


def inferred_roots(setup: str) -> list[str]:
    names = set(re.findall(r"(?m)^\s*(receiver|alias|arg\d+)\s*=", setup))
    return sorted(
        names,
        key=lambda name: (
            0 if name == "receiver" else 1 if name == "alias" else 2,
            name,
        ),
    )


class Corpus:
    def __init__(self) -> None:
        self.scenarios: list[dict[str, Any]] = []

    def concrete(
        self,
        rule_key: str,
        label: str,
        setup: str,
        call: str,
        outcome_kind: str,
        outcome_type: str,
        *,
        categories: list[str],
        events: list[str] | None = None,
        roots: list[str] | None = None,
        changed: list[str] | None = None,
        unchanged: list[str] | None = None,
        aliases: list[list[str]] | None = None,
        obligations: list[str] | None = None,
        note: str | None = None,
    ) -> str:
        sid = scenario_id(rule_key, label)
        row: dict[str, Any] = {
            "id": sid,
            "rule_key": rule_key,
            "scenario": label,
            "categories": sorted(set(categories + ["cpython_evidence"])),
            "execution": {
                "setup": setup.strip(),
                "call": call,
                "roots": roots if roots is not None else inferred_roots(setup),
            },
            "expect": {
                "outcome": {
                    "kind": outcome_kind,
                    "type": outcome_type,
                },
                "events": events if events is not None else [],
                "changed_roots": changed if changed is not None else [],
                "unchanged_roots": unchanged if unchanged is not None else [],
                "alias_groups_after": aliases if aliases is not None else [],
            },
            "obligations": obligations or [],
        }
        if note:
            row["note"] = note
        self.scenarios.append(row)
        return sid

    def normal(
        self,
        rule_key: str,
        setup: str,
        call: str,
        outcome_type: str,
        *,
        events: list[str] | None = None,
        roots: list[str] | None = None,
        changed: list[str] | None = None,
        unchanged: list[str] | None = None,
        aliases: list[list[str]] | None = None,
        note: str | None = None,
    ) -> str:
        return self.concrete(
            rule_key,
            "normal",
            setup,
            call,
            "return",
            outcome_type,
            categories=["inventory", "normal"],
            events=events,
            roots=roots,
            changed=changed,
            unchanged=unchanged,
            aliases=aliases,
            obligations=["normal-result", "post-state"],
            note=note,
        )

    def raises(
        self,
        rule_key: str,
        label: str,
        setup: str,
        call: str,
        exception: str,
        *,
        categories: list[str] | None = None,
        events: list[str] | None = None,
        roots: list[str] | None = None,
        changed: list[str] | None = None,
        unchanged: list[str] | None = None,
        aliases: list[list[str]] | None = None,
        note: str | None = None,
    ) -> str:
        return self.concrete(
            rule_key,
            label,
            setup,
            call,
            "raise",
            f"builtins.{exception}",
            categories=["invalid"] + (categories or []),
            events=events,
            roots=roots,
            changed=changed,
            unchanged=unchanged,
            aliases=aliases,
            obligations=["raised-class", "raise-point-state"],
            note=note,
        )

    def mixed(
        self,
        rule_key: str,
        label: str,
        witnesses: list[str],
        outcomes: list[str],
        *,
        note: str,
    ) -> None:
        self.scenarios.append(
            {
                "id": scenario_id(rule_key, label),
                "rule_key": rule_key,
                "scenario": label,
                "categories": ["cpython_evidence", "mixed_abstract"],
                "witnesses": witnesses,
                "expect": {
                    "abstract_outcomes": sorted(outcomes),
                    "same_abstract_input_state": True,
                },
                "obligations": [
                    "cartesian-alternative-inclusion",
                    "same-input-state",
                    "normal-and-raised-flow",
                ],
                "note": note,
            }
        )


def add_normal_scenarios(c: Corpus) -> dict[str, str]:
    normal: dict[str, str] = {}

    def n(
        key: str,
        setup: str,
        call: str,
        typ: str,
        **kwargs: Any,
    ) -> None:
        normal[key] = c.normal(key, setup, call, typ, **kwargs)

    # list
    n("list.append", "receiver = [1]\narg0 = 2",
      "receiver.append(arg0)", "builtins.NoneType", changed=["receiver"])
    n("list.clear", "receiver = [1]", "receiver.clear()",
      "builtins.NoneType", changed=["receiver"])
    n("list.copy", "receiver = [[1]]", "receiver.copy()", "builtins.list")
    n("list.count", "receiver = [1, 1, 2]\narg0 = 1",
      "receiver.count(arg0)", "builtins.int")
    n("list.extend", "receiver = [1]\narg0 = [2, 3]",
      "receiver.extend(arg0)", "builtins.NoneType", changed=["receiver"])
    n("list.index", "receiver = [1, 2]\narg0 = 2",
      "receiver.index(arg0)", "builtins.int")
    n("list.insert", "receiver = [1]\narg0 = 0\narg1 = 2",
      "receiver.insert(arg0, arg1)", "builtins.NoneType",
      changed=["receiver"])
    n("list.pop", "receiver = [1, 2]", "receiver.pop()", "builtins.int",
      changed=["receiver"])
    n("list.remove", "receiver = [1, 2]\narg0 = 1",
      "receiver.remove(arg0)", "builtins.NoneType", changed=["receiver"])
    n("list.reverse", "receiver = [1, 2]", "receiver.reverse()",
      "builtins.NoneType", changed=["receiver"])
    n("list.sort", "receiver = [2, 1]", "receiver.sort(reverse=False)",
      "builtins.NoneType", changed=["receiver"])

    # dict
    n("dict.clear", "receiver = {'a': 1}", "receiver.clear()",
      "builtins.NoneType", changed=["receiver"])
    n("dict.copy", "receiver = {'a': [1]}", "receiver.copy()",
      "builtins.dict")
    n("dict.fromkeys", "receiver = {}\narg0 = ['a', 'b']\narg1 = 1",
      "receiver.fromkeys(arg0, arg1)", "builtins.dict")
    n("dict.get", "receiver = {'a': 1}\narg0 = 'a'\narg1 = 0",
      "receiver.get(arg0, arg1)", "builtins.int")
    n("dict.items", "receiver = {'a': 1}", "receiver.items()",
      "builtins.dict_items")
    n("dict.keys", "receiver = {'a': 1}", "receiver.keys()",
      "builtins.dict_keys")
    n("dict.pop", "receiver = {'a': 1}\narg0 = 'a'",
      "receiver.pop(arg0)", "builtins.int", changed=["receiver"])
    n("dict.popitem", "receiver = {'a': 1}", "receiver.popitem()",
      "builtins.tuple", changed=["receiver"])
    n("dict.setdefault", "receiver = {}\narg0 = 'a'\narg1 = 1",
      "receiver.setdefault(arg0, arg1)", "builtins.int",
      changed=["receiver"])
    n("dict.update", "receiver = {'a': 1}\narg0 = {'b': 2}",
      "receiver.update(arg0, c=3)", "builtins.NoneType",
      changed=["receiver"])
    n("dict.values", "receiver = {'a': 1}", "receiver.values()",
      "builtins.dict_values")

    # set
    n("set.add", "receiver = {1}\narg0 = 2", "receiver.add(arg0)",
      "builtins.NoneType", changed=["receiver"])
    n("set.clear", "receiver = {1}", "receiver.clear()",
      "builtins.NoneType", changed=["receiver"])
    n("set.copy", "receiver = {1}", "receiver.copy()", "builtins.set")
    n("set.difference", "receiver = {1, 2}\narg0 = {2}",
      "receiver.difference(arg0)", "builtins.set")
    n("set.difference_update", "receiver = {1, 2}\narg0 = {2}",
      "receiver.difference_update(arg0)", "builtins.NoneType",
      changed=["receiver"])
    n("set.discard", "receiver = {1, 2}\narg0 = 1",
      "receiver.discard(arg0)", "builtins.NoneType", changed=["receiver"])
    n("set.intersection", "receiver = {1, 2}\narg0 = {2, 3}",
      "receiver.intersection(arg0)", "builtins.set")
    n("set.intersection_update", "receiver = {1, 2}\narg0 = {2, 3}",
      "receiver.intersection_update(arg0)", "builtins.NoneType",
      changed=["receiver"])
    n("set.isdisjoint", "receiver = {1}\narg0 = {2}",
      "receiver.isdisjoint(arg0)", "builtins.bool")
    n("set.issubset", "receiver = {1}\narg0 = {1, 2}",
      "receiver.issubset(arg0)", "builtins.bool")
    n("set.issuperset", "receiver = {1, 2}\narg0 = {1}",
      "receiver.issuperset(arg0)", "builtins.bool")
    n("set.pop", "receiver = {1}", "receiver.pop()", "builtins.int",
      changed=["receiver"])
    n("set.remove", "receiver = {1, 2}\narg0 = 1",
      "receiver.remove(arg0)", "builtins.NoneType", changed=["receiver"])
    n("set.symmetric_difference", "receiver = {1, 2}\narg0 = {2, 3}",
      "receiver.symmetric_difference(arg0)", "builtins.set")
    n("set.symmetric_difference_update",
      "receiver = {1, 2}\narg0 = {2, 3}",
      "receiver.symmetric_difference_update(arg0)", "builtins.NoneType",
      changed=["receiver"])
    n("set.union", "receiver = {1}\narg0 = {2}",
      "receiver.union(arg0)", "builtins.set")
    n("set.update", "receiver = {1}\narg0 = {2}",
      "receiver.update(arg0)", "builtins.NoneType", changed=["receiver"])

    # tuple and range
    n("tuple.count", "receiver = (1, 2, 1)\narg0 = 1",
      "receiver.count(arg0)", "builtins.int")
    n("tuple.index", "receiver = (1, 2)\narg0 = 2",
      "receiver.index(arg0)", "builtins.int")
    n("range.count", "receiver = range(5)\narg0 = 2",
      "receiver.count(arg0)", "builtins.int")
    n("range.index", "receiver = range(5)\narg0 = 2",
      "receiver.index(arg0)", "builtins.int")

    # strings
    string_normals = [
        ("capitalize", "receiver.capitalize()", "builtins.str"),
        ("casefold", "receiver.casefold()", "builtins.str"),
        ("center", "receiver.center(8, '.')", "builtins.str"),
        ("count", "receiver.count('a', 0, 8)", "builtins.int"),
        ("encode", "receiver.encode('utf-8', 'strict')", "builtins.bytes"),
        ("endswith", "receiver.endswith('a', 0, 8)", "builtins.bool"),
        ("expandtabs", "receiver.expandtabs(4)", "builtins.str"),
        ("find", "receiver.find('a', 0, 8)", "builtins.int"),
        ("format", "'{}:{}'.format('a', 1)", "builtins.str"),
        ("format_map", "'{name}'.format_map({'name': 'value'})",
         "builtins.str"),
        ("index", "receiver.index('a', 0, 8)", "builtins.int"),
        ("isalnum", "receiver.isalnum()", "builtins.bool"),
        ("isalpha", "receiver.isalpha()", "builtins.bool"),
        ("isascii", "receiver.isascii()", "builtins.bool"),
        ("isdecimal", "'12'.isdecimal()", "builtins.bool"),
        ("isdigit", "'12'.isdigit()", "builtins.bool"),
        ("isidentifier", "'name'.isidentifier()", "builtins.bool"),
        ("islower", "'abc'.islower()", "builtins.bool"),
        ("isnumeric", "'12'.isnumeric()", "builtins.bool"),
        ("isprintable", "receiver.isprintable()", "builtins.bool"),
        ("isspace", "' \\t'.isspace()", "builtins.bool"),
        ("istitle", "'A Title'.istitle()", "builtins.bool"),
        ("isupper", "'ABC'.isupper()", "builtins.bool"),
        ("join", "','.join(['a', 'b'])", "builtins.str"),
        ("ljust", "receiver.ljust(8, '.')", "builtins.str"),
        ("lower", "receiver.lower()", "builtins.str"),
        ("lstrip", "receiver.lstrip()", "builtins.str"),
        ("maketrans", "receiver.maketrans('ab', 'AB', ' ')", "builtins.dict"),
        ("partition", "receiver.partition('a')", "builtins.tuple"),
        ("removeprefix", "receiver.removeprefix('A')", "builtins.str"),
        ("removesuffix", "receiver.removesuffix('a')", "builtins.str"),
        ("replace", "receiver.replace('a', 'A', 1)", "builtins.str"),
        ("rfind", "receiver.rfind('a', 0, 8)", "builtins.int"),
        ("rindex", "receiver.rindex('a', 0, 8)", "builtins.int"),
        ("rjust", "receiver.rjust(8, '.')", "builtins.str"),
        ("rpartition", "receiver.rpartition('a')", "builtins.tuple"),
        ("rsplit", "receiver.rsplit('a', 1)", "builtins.list"),
        ("rstrip", "receiver.rstrip()", "builtins.str"),
        ("split", "receiver.split('a', 1)", "builtins.list"),
        ("splitlines", "'a\\nb'.splitlines(True)", "builtins.list"),
        ("startswith", "receiver.startswith('A', 0, 8)", "builtins.bool"),
        ("strip", "receiver.strip()", "builtins.str"),
        ("swapcase", "receiver.swapcase()", "builtins.str"),
        ("title", "receiver.title()", "builtins.str"),
        ("translate", "receiver.translate({97: 'A'})", "builtins.str"),
        ("upper", "receiver.upper()", "builtins.str"),
        ("zfill", "'12'.zfill(4)", "builtins.str"),
    ]
    for method, call, typ in string_normals:
        n(f"str.{method}", "receiver = 'Alpha'", call, typ)

    # generators
    generator_setup = """
def worker():
    received = yield 'ready'
    try:
        yield received
    except ValueError:
        yield 'caught'
receiver = worker()
arg0 = None
"""
    n("gen.close", generator_setup + "\nnext(receiver)",
      "receiver.close()", "builtins.NoneType", changed=["receiver"])
    n("gen.send", generator_setup + "\nnext(receiver)\narg0 = 7",
      "receiver.send(arg0)", "builtins.int", changed=["receiver"])
    n("gen.throw",
      generator_setup
      + "\nnext(receiver)\nreceiver.send(None)\narg0 = ValueError('x')",
      "receiver.throw(arg0)", "builtins.str", changed=["receiver"])

    # builtin functions and constructors
    n("len", "arg0 = [1, 2]", "len(arg0)", "builtins.int")
    n("range", "arg0 = 0\narg1 = 3\narg2 = 1",
      "range(arg0, arg1, arg2)", "builtins.range")
    n(
        "print",
        """
class Sink:
    def __init__(self):
        self.parts = []
    def write(self, text):
        self.parts.append(text)
    def flush(self):
        self.parts.append('<flush>')
arg0 = 'x'
arg1 = 'y'
sink = Sink()
""",
        "print(arg0, arg1, sep=':', end='!', file=sink, flush=True)",
        "builtins.NoneType",
        roots=["arg0", "arg1", "sink"],
        changed=["sink"],
    )
    n("isinstance", "arg0 = []\narg1 = list",
      "isinstance(arg0, arg1)", "builtins.bool")
    n("next", "arg0 = iter([1])", "next(arg0)", "builtins.int",
      changed=["arg0"])
    n("iter", "arg0 = [1]", "iter(arg0)", "builtins.list_iterator")
    n("str", "arg0 = 12", "str(arg0)", "builtins.str")
    n("repr", "arg0 = [1]", "repr(arg0)", "builtins.str")
    n("list", "arg0 = (1, 2)", "list(arg0)", "builtins.list")
    n("dict", "arg0 = {'a': 1}", "dict(arg0, b=2)", "builtins.dict")
    n("set", "arg0 = [1, 2]", "set(arg0)", "builtins.set")
    n("tuple", "arg0 = [1, 2]", "tuple(arg0)", "builtins.tuple")

    return normal


def add_failure_and_effect_scenarios(
    c: Corpus, normal: dict[str, str]
) -> dict[str, str]:
    witnesses: dict[str, str] = {}

    def remember(name: str, sid: str) -> None:
        witnesses[name] = sid

    # SupportsIndex, ordered iteration, search, and mutation phases.
    remember("list_insert_type", c.raises(
        "list.insert", "invalid_index_type",
        "receiver = [1]\narg0 = 'bad'\narg1 = 2",
        "receiver.insert(arg0, arg1)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    ))
    c.concrete(
        "list.insert", "index_hook_effect",
        """
class Index:
    def __init__(self):
        self.calls = 0
    def __index__(self):
        self.calls += 1
        events.append('Index.__index__')
        return 0
receiver = [1]
arg0 = Index()
arg1 = 2
""",
        "receiver.insert(arg0, arg1)", "return", "builtins.NoneType",
        categories=["hook_effect", "mutation_phase"],
        events=["Index.__index__"], changed=["receiver", "arg0"],
    )
    c.raises(
        "list.insert", "index_hook_raises_after_effect",
        """
class Index:
    def __init__(self):
        self.calls = 0
    def __index__(self):
        self.calls += 1
        events.append('Index.__index__')
        raise ValueError('index failed')
receiver = [1]
arg0 = Index()
arg1 = 2
""",
        "receiver.insert(arg0, arg1)", "ValueError",
        categories=["hook_effect", "mutation_phase"],
        events=["Index.__index__"], changed=["arg0"], unchanged=["receiver"],
    )
    remember("list_extend_type", c.raises(
        "list.extend", "non_iterable",
        "receiver = [1]\narg0 = 3",
        "receiver.extend(arg0)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    ))
    c.raises(
        "list.extend", "partial_iteration_then_raise",
        """
class Source:
    def __init__(self):
        self.index = 0
    def __iter__(self):
        events.append('Source.__iter__')
        return self
    def __next__(self):
        events.append(f'Source.__next__:{self.index}')
        if self.index == 0:
            self.index += 1
            return 2
        raise LookupError('iteration failed')
receiver = [1]
arg0 = Source()
""",
        "receiver.extend(arg0)", "LookupError",
        categories=["hook_effect", "mutation_phase"],
        events=["Source.__iter__", "Source.__next__:0", "Source.__next__:1"],
        changed=["receiver", "arg0"],
    )
    remember("list_pop_empty", c.raises(
        "list.pop", "empty", "receiver = []", "receiver.pop()", "IndexError",
        categories=["alias_emptiness", "mutation_phase"], unchanged=["receiver"],
    ))
    c.raises(
        "list.pop", "invalid_index_type",
        "receiver = [1]\narg0 = 'bad'", "receiver.pop(arg0)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    )
    c.raises(
        "list.remove", "missing",
        "receiver = [1]\narg0 = 2", "receiver.remove(arg0)", "ValueError",
        categories=["alias_emptiness"], unchanged=["receiver"],
    )
    c.raises(
        "list.remove", "equality_hook_raises",
        """
class Element:
    def __init__(self):
        self.comparisons = 0
    def __eq__(self, other):
        self.comparisons += 1
        events.append('Element.__eq__')
        raise RuntimeError('comparison failed')
receiver = [Element()]
arg0 = 2
""",
        "receiver.remove(arg0)", "RuntimeError",
        categories=["hook_effect", "mutation_phase"],
        events=["Element.__eq__"], changed=["receiver"], unchanged=["arg0"],
    )
    c.raises(
        "list.count", "hook_memory_error",
        """
class Element:
    def __eq__(self, other):
        events.append('Element.__eq__')
        raise MemoryError('deliberate oracle witness')
receiver = [Element()]
arg0 = 2
""",
        "receiver.count(arg0)", "MemoryError",
        categories=["hook_effect"], events=["Element.__eq__"],
    )
    c.raises(
        "list.index", "invalid_bound_type",
        "receiver = [1]\narg0 = 1\narg1 = 'bad'",
        "receiver.index(arg0, arg1)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    )
    c.raises(
        "list.sort", "key_callback_raises",
        """
class Key:
    def __init__(self):
        self.calls = 0
    def __call__(self, value):
        self.calls += 1
        events.append(f'Key:{value}')
        if value == 1:
            raise OSError('key failed')
        return value
receiver = [2, 1]
arg0 = Key()
""",
        "receiver.sort(key=arg0)", "OSError",
        categories=["hook_effect", "mutation_phase"],
        events=["Key:2", "Key:1"], changed=["arg0"],
    )
    c.concrete(
        "list.append", "must_alias_receiver",
        "receiver = []\nalias = receiver\narg0 = 1",
        "receiver.append(arg0)", "return", "builtins.NoneType",
        categories=["alias_emptiness", "mutation_phase"],
        changed=["receiver", "alias"], aliases=[["alias", "receiver"]],
    )
    c.concrete(
        "list.clear", "must_alias_receiver",
        "receiver = [1]\nalias = receiver",
        "receiver.clear()", "return", "builtins.NoneType",
        categories=["alias_emptiness", "mutation_phase"],
        changed=["receiver", "alias"], aliases=[["alias", "receiver"]],
    )

    # Hashing, set emptiness, partial updates, and self aliases.
    remember("set_add_type", c.raises(
        "set.add", "unhashable",
        "receiver = {1}\narg0 = []", "receiver.add(arg0)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    ))
    c.raises(
        "set.add", "hash_hook_raises_after_effect",
        """
class Key:
    def __init__(self):
        self.calls = 0
    def __hash__(self):
        self.calls += 1
        events.append('Key.__hash__')
        raise LookupError('hash failed')
receiver = {1}
arg0 = Key()
""",
        "receiver.add(arg0)", "LookupError",
        categories=["hook_effect", "mutation_phase"],
        events=["Key.__hash__"], changed=["arg0"], unchanged=["receiver"],
    )
    c.raises(
        "set.remove", "missing",
        "receiver = {1}\narg0 = 2", "receiver.remove(arg0)", "KeyError",
        categories=["alias_emptiness"], unchanged=["receiver"],
    )
    remember("set_pop_empty", c.raises(
        "set.pop", "empty", "receiver = set()", "receiver.pop()", "KeyError",
        categories=["alias_emptiness", "mutation_phase"], unchanged=["receiver"],
    ))
    c.raises(
        "set.update", "partial_update_then_unhashable",
        "receiver = {0}\narg0 = [1, []]",
        "receiver.update(arg0)", "TypeError",
        categories=["mutation_phase"], changed=["receiver"],
    )
    c.raises(
        "set.difference_update", "non_iterable",
        "receiver = {1, 2}\narg0 = 3",
        "receiver.difference_update(arg0)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    )
    c.raises(
        "set.intersection_update", "non_iterable",
        "receiver = {1, 2}\narg0 = 3",
        "receiver.intersection_update(arg0)", "TypeError",
        categories=["mutation_phase"],
    )
    c.raises(
        "set.symmetric_difference_update", "non_iterable",
        "receiver = {1, 2}\narg0 = 3",
        "receiver.symmetric_difference_update(arg0)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
    )
    for method in (
        "difference_update",
        "intersection_update",
        "symmetric_difference_update",
    ):
        changes = [] if method == "intersection_update" else ["receiver", "alias"]
        c.concrete(
            f"set.{method}", "self_alias",
            "receiver = {1, 2}\nalias = receiver",
            f"receiver.{method}(alias)", "return", "builtins.NoneType",
            categories=["alias_emptiness", "mutation_phase"],
            changed=changes, aliases=[["alias", "receiver"]],
        )

    # Equality-search methods.
    c.raises(
        "tuple.index", "missing",
        "receiver = (1,)\narg0 = 2", "receiver.index(arg0)", "ValueError",
        categories=["alias_emptiness"],
    )
    c.raises(
        "tuple.index", "invalid_bound_type",
        "receiver = (1,)\narg0 = 1\narg1 = 'bad'",
        "receiver.index(arg0, arg1)", "TypeError",
    )
    c.raises(
        "tuple.count", "equality_hook_raises",
        """
class Element:
    def __eq__(self, other):
        events.append('Element.__eq__')
        raise RuntimeError('comparison failed')
receiver = (Element(),)
arg0 = 1
""",
        "receiver.count(arg0)", "RuntimeError",
        categories=["hook_effect"], events=["Element.__eq__"],
    )
    c.raises(
        "range.index", "missing",
        "receiver = range(2)\narg0 = 4", "receiver.index(arg0)", "ValueError",
        categories=["alias_emptiness"],
    )

    # Dictionary hash/equality, live views, partial mutation, and emptiness.
    remember("dict_get_type", c.raises(
        "dict.get", "unhashable_key",
        "receiver = {'a': 1}\narg0 = []",
        "receiver.get(arg0)", "TypeError", unchanged=["receiver"],
    ))
    c.raises(
        "dict.get", "hash_hook_raises_after_effect",
        """
class Key:
    def __init__(self):
        self.calls = 0
    def __hash__(self):
        self.calls += 1
        events.append('Key.__hash__')
        raise LookupError('hash failed')
receiver = {'a': 1}
arg0 = Key()
""",
        "receiver.get(arg0)", "LookupError",
        categories=["hook_effect"], events=["Key.__hash__"],
        changed=["arg0"], unchanged=["receiver"],
    )
    c.raises(
        "dict.pop", "missing",
        "receiver = {}\narg0 = 'a'", "receiver.pop(arg0)", "KeyError",
        categories=["alias_emptiness", "mutation_phase"], unchanged=["receiver"],
    )
    c.concrete(
        "dict.keys", "live_view_observes_mutation",
        """
receiver = {'a': 1}
