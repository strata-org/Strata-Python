        categories=["mutation_phase"], changed=["receiver"],
    )
    c.raises(
        "dict.update", "partial_pairs_then_unhashable",
        "receiver = {}\narg0 = [('a', 1), ([], 2)]",
        "receiver.update(arg0)", "TypeError",
        categories=["mutation_phase"], changed=["receiver"],
    )
    c.raises(
        "dict.fromkeys", "iterator_raises",
        """
class Source:
    def __init__(self):
        self.index = 0
