    c.raises(
        "isinstance", "invalid_classinfo",
        "arg0 = 1\narg1 = 2", "isinstance(arg0, arg1)", "TypeError",
    )
    remember("range_type", c.raises(
        "range", "invalid_operand",
        "arg0 = 'bad'", "range(arg0)", "TypeError",
    ))
    c.raises(
        "range", "zero_step",
        "arg0 = 0\narg1 = 3\narg2 = 0",
        "range(arg0, arg1, arg2)", "ValueError",
    )
    remember("iter_type", c.raises(
        "iter", "non_iterable", "arg0 = 1", "iter(arg0)", "TypeError",
    ))
    c.concrete(
        "iter", "sequence_fallback",
        """
