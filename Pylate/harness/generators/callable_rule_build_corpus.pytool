        "list(iter(arg0))", "return", "builtins.list",
        categories=["hook_effect", "mutation_phase"],
        events=["Sequence.__getitem__:0", "Sequence.__getitem__:1"],
        changed=["arg0"],
    )
    remember("next_type", c.raises(
        "next", "non_iterator", "arg0 = 1", "next(arg0)", "TypeError",
    ))
    remember("next_empty", c.raises(
        "next", "exhausted", "arg0 = iter([])", "next(arg0)",
        "StopIteration", categories=["alias_emptiness", "mutation_phase"],
    ))
    for constructor in ("list", "tuple"):
        c.raises(
            constructor, "non_iterable", "arg0 = 1",
            f"{constructor}(arg0)", "TypeError",
        )
    c.raises(
        "list", "iterator_raises_after_yield",
        """
class Source:
    def __init__(self):
        self.index = 0
    def __iter__(self):
        events.append('Source.__iter__')
        return self
    def __next__(self):
        events.append(f'Source.__next__:{self.index}')
        if self.index == 0:
            self.index += 1
            return 1
