    view = receiver.values()
    receiver['b'] = 2
    return (view, list(view))
""",
        "invoke()", "return", "builtins.tuple",
        categories=["alias_emptiness", "mutation_phase"],
        changed=["receiver"],
    )
    c.concrete(
        "dict.items", "live_view_observes_mutation",
        """
