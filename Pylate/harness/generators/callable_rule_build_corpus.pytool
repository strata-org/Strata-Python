arg0 = Source()
""",
        "receiver.fromkeys(arg0)", "RuntimeError",
        categories=["hook_effect", "mutation_phase"],
        events=["Source.__iter__", "Source.__next__:0", "Source.__next__:1"],
        changed=["arg0"], unchanged=["receiver"],
    )
    remember("dict_popitem_empty", c.raises(
        "dict.popitem", "empty", "receiver = {}", "receiver.popitem()",
        "KeyError", categories=["alias_emptiness", "mutation_phase"],
        unchanged=["receiver"],
    ))

    # String contracts, format protocols, codecs, and opaque rows.
    for method in ("strip", "lstrip", "rstrip"):
        sid = c.raises(
            f"str.{method}", "invalid_chars",
            "receiver = 'abc'\narg0 = 1",
            f"receiver.{method}(arg0)", "TypeError",
        )
        if method == "strip":
            remember("str_strip_type", sid)
    c.raises(
        "str.replace", "invalid_old",
        "receiver = 'abc'\narg0 = 1\narg1 = 'x'",
        "receiver.replace(arg0, arg1)", "TypeError",
    )
    c.raises(
        "str.join", "invalid_element",
        "receiver = ','\narg0 = ['a', 1]",
        "receiver.join(arg0)", "TypeError",
        categories=["mutation_phase"],
    )
    c.raises(
        "str.join", "iterator_raises_after_yield",
        """
class Source:
    def __init__(self):
        self.index = 0
    def __iter__(self):
        events.append('Source.__iter__')
        return self
