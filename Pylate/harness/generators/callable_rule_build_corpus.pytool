    c.raises(
        "dict.setdefault", "unhashable_key",
        "receiver = {}\narg0 = []\narg1 = 1",
        "receiver.setdefault(arg0, arg1)", "TypeError",
        categories=["mutation_phase"], unchanged=["receiver"],
