module

-- The compile+run pipeline (`compileAndRun`) and the failure-to-pattern helpers are
-- shared with the read side (`StrataPythonTest.InterpretGolden.Generate`) so the
-- write and read sides cannot drift.
import StrataPythonTest.InterpretGolden.Matching

open StrataPython.GoldenText

/-! # `pyInterpretUpdate` — regenerate interpret `.expected` files and report divergence

The golden interpret tests (generated by `StrataPythonTest.InterpretGolden.Generate`)
only *check* each corpus case against its committed expectation. This executable
carries the two write-side chores — re-baselining the expectations and reporting
divergence:

  - `--update`: run the corpus under one front end and rewrite each
    `<expected_dir>/<stem>.expected` from the actual failure, so a deliberate
    pipeline change can re-baseline the goldens. A case that now passes has its
    `.expected` removed; a case whose stored pattern still matches is kept
    byte-for-byte, so a hand-relaxed pattern survives regeneration.
  - the V1/V2 divergence count: how many cases differ between
    `expected_interpret_v1/` and `expected_interpret/`, printed after a `--v2` run.

Run it from the package root. Update one front end at a time:

    lake exe pyInterpretUpdate            # V1 (expected_interpret_v1/)
    lake exe pyInterpretUpdate --v2       # V2 (expected_interpret/), then prints divergence

Options: `--v2` selects the V2 front end; `--filter <substr>` restricts to cases
whose name contains `<substr>`. Requires Python with `strata_python.gen` (the build
exports `PYTHON`; otherwise `python3`) and the `pyInterpret` binary at
`.lake/build/bin/pyInterpret` (build it with `lake build pyInterpret`).

The regex-shaped steps — matching output against a stored pattern, and deriving a
pattern from a failure — are delegated to `grep -qE` and a `sed` pipeline rather
than reimplemented in Lean. -/

namespace StrataPython.InterpretGolden.Update

/-- Run one `sed` program (optionally extended) over `input` via a temp file. -/
private def sedProg (extended : Bool) (prog input : String) : IO String := do
  IO.FS.withTempDir fun dir => do
    let f := dir / "in"
    IO.FS.writeFile f input
    let args := (if extended then #["-E"] else #[]) ++ #["-e", prog, f.toString]
    return (← IO.Process.output { cmd := "sed", args, inheritEnv := true }).stdout

/-- Turn one failure line into the pattern stored in an `.expected` file, via three
    `sed` passes. Stage one replaces the identifiers that are not stable across runs
    (assertion numbering, Ion byte offsets and spans, a Lean source `line:col` in a
    PANIC, generated type variables) with two placeholder control bytes (SOH and STX);
    stage two escapes every regex metacharacter literally; stage three restores the
    placeholders to `[0-9]+` / `[0-9]+-[0-9]+`. The placeholders are embedded as
    literal bytes, so matching never relies on sed interpreting a `\xNN` escape — a
    GNU extension BSD/macOS sed treats literally and would otherwise corrupt the
    derived pattern there. -/
private def derivePattern (reason : String) : IO String := do
  let s1 ← sedProg (extended := true)
    "s/(assert|assume)\\(([0-9]+)\\)/\\1(\x01)/g; \
     s/byteIdx := [0-9]+/byteIdx := \x01/g; \
     s/([A-Za-z0-9_.]):[0-9]+:[0-9]+/\\1:\x01:\x01/g; \
     s/(\\$__[A-Za-z]+)[0-9]+/\\1\x01/g; \
     s/\\(([0-9]+)-([0-9]+)\\)/(\x02)/g" reason
  let s2 ← sedProg (extended := false) "s/[][(){}.*+?^$\\\\|]/\\\\&/g" s1
  sedProg (extended := false) "s/\x01/[0-9]+/g; s/\x02/[0-9]+-[0-9]+/g" s2

/-- The corpus stems (basename without `.py`), sorted, optionally filtered. -/
private def corpusStems (root : System.FilePath) (filter : Option String)
    : IO (Array String) := do
  let testsDir := root / "StrataPythonTest" / "tests"
  let mut stems := #[]
  for de in ← testsDir.readDir do
    let fn := de.fileName
    if fn.startsWith "test_" && fn.endsWith ".py" then
      let stem := (fn.dropEnd ".py".length).toString
      if filter.all (hasSub stem ·) then
        stems := stems.push stem
  return stems.qsort (· < ·)

/-- Derive a pattern from the failure and write it to `expectedFile`, unless it would
    be empty. An output of only blank lines, backtraces, a `trace:`/CLI-hint line or an
    indented `AST:` dump leaves `failureReason` empty and so `derivePattern` empty, and
    the read side rejects an empty `.expected` ("must contain a pattern"), so writing one
    would make the suite fail on its next run. Returns the written pattern (trailing
    newline stripped) for the log line, or `none` when it refused to write. -/
private def writeDerived (expectedFile : System.FilePath) (output : String) :
    IO (Option String) := do
  let pat ← derivePattern (failureReason output)
  let trimmed := rstripNewlines pat
  if trimmed.isEmpty then
    return none
  IO.FS.writeFile expectedFile pat
  return some trimmed

/-- Rewrite one front end's `.expected` files from the actual interpreter output. -/
private def update (python : String) (root : System.FilePath) (v2 : Bool)
    (filter : Option String) : IO Unit := do
  let expectedDir := root / "StrataPythonTest" /
    (if v2 then "expected_interpret" else "expected_interpret_v1")
  for stem in ← corpusStems root filter do
    -- The imported regression corpus is V2-only (marked by a `.desired` sidecar).
    if !v2 && (← (root / "StrataPythonTest" / "expected_interpret"
        / (stem ++ ".desired")).pathExists) then
      continue
    if ← (expectedDir / (stem ++ ".skip")).pathExists then
      IO.println s!"SKIP: {stem}"
      continue
    let some (exitCode, output) ← compileAndRun python root stem v2
      | IO.println s!"SKIP (parse): {stem}"; continue
    let expectedFile := expectedDir / (stem ++ ".expected")
    if ← expectedFile.pathExists then
      if exitCode == 0 then
        try IO.FS.removeFile expectedFile catch _ => pure ()
        IO.println s!"Updated: {stem} (now passes, removed expected file)"
      else if ← matchesPattern (rstripNewlines (← IO.FS.readFile expectedFile)) output then
        -- Still matches: keep the stored pattern byte for byte.
        IO.println s!"Kept:    {stem}"
      else
        match ← writeDerived expectedFile output with
        | some p => IO.println s!"Updated: {stem} — {p}"
        | none   => IO.println s!"WARN: {stem} — no non-empty pattern derivable from \
            the failure; kept the existing .expected"
    else if exitCode != 0 then
      match ← writeDerived expectedFile output with
      | some p => IO.println s!"Created: {stem} — {p}"
      | none   => IO.println s!"WARN: {stem} — failed but no non-empty pattern derivable; \
          wrote no .expected (fix by hand)"
    else
      IO.println s!"OK:   {stem}"

/-- The V1/V2 divergence count, printed after a `--v2` update. A case's state is
    `skip`, the stored `.expected` pattern, or `pass` (no sidecar). Cases V1 does
    not run (the imported corpus, marked by `.desired`) are excluded. -/
private def reportDivergence (root : System.FilePath) : IO Unit := do
  let v1Dir := root / "StrataPythonTest" / "expected_interpret_v1"
  let v2Dir := root / "StrataPythonTest" / "expected_interpret"
  let stateOf (dir : System.FilePath) (stem : String) : IO String := do
    if ← (dir / (stem ++ ".skip")).pathExists then return "skip"
    let ef := dir / (stem ++ ".expected")
    if ← ef.pathExists then return rstripNewlines (← IO.FS.readFile ef) else return "pass"
  let mut total := 0
  let mut diverging := 0
  for stem in ← corpusStems root none do
    if ← (v2Dir / (stem ++ ".desired")).pathExists then continue
    total := total + 1
    if (← stateOf v1Dir stem) != (← stateOf v2Dir stem) then
      diverging := diverging + 1
  IO.println ""
  IO.println s!"V1/V2 divergence: {diverging} of {total} case(s) differ between \
                expected_interpret_v1/ and expected_interpret/."

end StrataPython.InterpretGolden.Update

open StrataPython.InterpretGolden.Update

public def main (args : List String) : IO UInt32 := do
  let mut v2 := false
  let mut filter : Option String := none
  let mut rest := args
  while !rest.isEmpty do
    match rest with
    | "--v2" :: t => v2 := true; rest := t
    | "--filter" :: p :: t => filter := some p; rest := t
    | "--filter" :: [] => IO.eprintln "--filter requires an argument"; return 1
    | a :: _ => IO.eprintln s!"Unknown option: {a}"; return 1
    | [] => rest := []
  let root ← IO.currentDir
  let python := ((← IO.getEnv "PYTHON").getD "python3")
  let interp := root / ".lake" / "build" / "bin" / "pyInterpret"
  unless ← interp.pathExists do
    IO.eprintln s!"pyInterpret not built at {interp}; run `lake build pyInterpret`"
    return 1
  IO.println s!"Updating the {if v2 then "V2" else "V1"} front end ..."
  update python root v2 filter
  if v2 then
    reportDivergence root
  return 0
