module

-- The compile+analyze pipeline and the label normalizer are shared with the read side
-- (`StrataPythonTest.AnalyzeGolden.Generate`) so the write and read sides cannot drift.
import StrataPythonTest.AnalyzeGolden.Matching

open StrataPython.GoldenText

/-! # `pyAnalyzeUpdate`: regenerate analyze goldens, report divergence, run pending cases

The golden analyze tests (generated by `StrataPythonTest.AnalyzeGolden.Generate`) only
*check* each corpus case against its committed golden. This executable carries the
write-side and exploratory chores:

  - `--update`: run every case that has a golden under one front end and rewrite
    `<expected_dir>/<stem>.expected` from the normalized output, so a deliberate
    pipeline change can re-baseline the goldens. The `user_errors.txt` the analyzer
    writes replaces `<stem>.user_errors.expected`; a stale `user_errors` golden is
    removed when the case no longer writes one.
  - the V1/V2 divergence count: how many goldens differ between
    `expected_laurel_v1/` and `expected_laurel/`, printed after a `--v2` run.
  - `--pending`: run `tests/pending/test_*.py` (cases with no golden yet) and classify
    each as a parse error, an analysis error, imprecise (some obligation failed or was
    inconclusive), soundness (marked `# strata-pending: soundness`: a known soundness
    bug, so a clean result is expected), or pass.
  - `--check-pending`: as `--pending`, and exit non-zero if a V1 pending case now
    passes cleanly, so it can be promoted into `tests/` with a golden. Promotion is
    decided by V1, the shipping front end; a V2 pass is only noted.

Without `--update`, the cases that have a golden are checked against it and
mismatches reported, as the generated tests do; the pending flags add their run after
that pass.

Run it from the package root:

    lake exe pyAnalyzeUpdate --update          # V1 (expected_laurel_v1/)
    lake exe pyAnalyzeUpdate --v2 --update     # V2 (expected_laurel/), then prints divergence
    lake exe pyAnalyzeUpdate --check-pending   # V1 pending cases

Options: `--v2` selects the V2 front end; `--filter <substr>` restricts to cases whose
name contains `<substr>`; `--vc-directory <dir>` stores the VCs in SMT-Lib format in
`<dir>`. Requires Python with `strata_python.gen` (the build exports `PYTHON`;
otherwise `python3`), cvc5 and z3 on PATH, and the analyzer binary under
`.lake/build/bin` (build it with `lake build pyAnalyzeLaurel pyAnalyzeV2`). -/

namespace StrataPython.AnalyzeGolden.Update

/-- The stems (basename without `.py`) of `StrataPythonTest/<subdir>/test_*.py`,
    sorted, optionally filtered. -/
private def corpusStems (root : System.FilePath) (subdir : String) (filter : Option String)
    : IO (Array String) := do
  let dir := root / "StrataPythonTest" / subdir
  unless ← dir.pathExists do return #[]
  let mut stems := #[]
  for de in ← dir.readDir do
    let fn := de.fileName
    if fn.startsWith "test_" && fn.endsWith ".py" then
      let stem := String.ofList (fn.toList.take (fn.length - ".py".length))
      if filter.all (hasSub stem ·) then
        stems := stems.push stem
  return stems.qsort (· < ·)

/-- Check or rewrite one front end's goldens. Returns whether every case passed (a
    check-mode mismatch or a compile failure counts as a failure). -/
private def runGoldens (python : String) (root : System.FilePath) (v2 update : Bool)
    (filter : Option String) (vcArgs : Array String) : IO Bool := do
  let expectedDir := root / "StrataPythonTest" / expectedDirName v2
  let mut ok := true
  for stem in ← corpusStems root "tests" filter do
    let expectedFile := expectedDir / (stem ++ ".expected")
    unless ← expectedFile.pathExists do continue
    let r ← match ← compileAndAnalyze python root stem v2 vcArgs with
      | .ok r => pure r
      | .error _ =>
        IO.println s!"ERROR: py_to_strata failed for {stem}"
        ok := false
        continue
    let output := normalizeOutput r.stdout
    let ueFile := expectedDir / (stem ++ ".user_errors.expected")
    if update then
      IO.FS.writeFile expectedFile output
      IO.println s!"Updated: {expectedFile}"
      match r.userErrors with
      | some ue =>
        IO.FS.writeFile ueFile ue
        IO.println s!"Updated: {ueFile}"
      | none =>
        if ← ueFile.pathExists then
          IO.FS.removeFile ueFile
          IO.println s!"Removed (no user errors emitted): {ueFile}"
    else
      if output != (← IO.FS.readFile expectedFile) then
        IO.println s!"ERROR: Analysis output for {stem} does not match {expectedFile}"
        ok := false
      else
        IO.println s!"Test passed: {stem}"
      if ← ueFile.pathExists then
        match r.userErrors with
        | none =>
          IO.println s!"ERROR: user_errors.txt not generated for {stem}"
          ok := false
        | some ue =>
          if ue != (← IO.FS.readFile ueFile) then
            IO.println s!"ERROR: user_errors.txt content for {stem} does not match {ueFile}"
            ok := false
          else
            IO.println s!"Test passed: {stem} (user_errors.txt)"
  return ok

/-- `s` has a run of digits containing a non-zero digit immediately before
    ` failed` or ` inconclusive`, as the extended regex
    `[1-9][0-9]* (failed|inconclusive)` finds. -/
private def hasNonzeroCount (s : String) : Bool :=
  [" failed", " inconclusive"].any fun word =>
    let parts := s.splitOn word
    (parts.dropLast).any fun before =>
      let digits := before.toList.reverse.takeWhile (fun c => '0' ≤ c && c ≤ '9')
      digits.any (· != '0')

/-- The analyzer reported an error or a panic in its combined output. -/
private def mentionsError (s : String) : Bool :=
  ["error", "Error", "ERROR", "panic", "PANIC"].any (hasSub s ·)

/-- Run and classify the `tests/pending/` cases. Returns the count that passed cleanly
    without a soundness marker. -/
private def runPending (python : String) (root : System.FilePath) (v2 : Bool)
    (filter : Option String) (vcArgs : Array String) : IO Nat := do
  let mut total := 0
  let mut nError := 0
  let mut nImprecise := 0
  let mut nSoundness := 0
  let mut nPass := 0
  for stem in ← corpusStems root "tests/pending" filter do
    total := total + 1
    let source ← IO.FS.readFile (root / "StrataPythonTest" / "tests" / "pending" / (stem ++ ".py"))
    match ← compileAndAnalyze python root stem v2 vcArgs (subdir := "tests/pending")
        (timeoutSecs := some "20") with
    | .error _ =>
      IO.println s!"Pending (parse error):    {stem}"
      nError := nError + 1
    | .ok r =>
      let output := r.stdout ++ r.stderr
      if r.exitCode != 0 || mentionsError output then
        IO.println s!"Pending (analysis error): {stem}"
        nError := nError + 1
      else if hasNonzeroCount output then
        IO.println s!"Pending (imprecise):      {stem}"
        nImprecise := nImprecise + 1
      else if (source.splitOn "\n").any (·.startsWith "# strata-pending: soundness") then
        IO.println s!"Pending (soundness):      {stem}"
        nSoundness := nSoundness + 1
      else
        IO.println s!"Pending (pass):           {stem}"
        nPass := nPass + 1
  if total > 0 then
    IO.println ""
    IO.println s!"Pending ({if v2 then "V2" else "V1"}): {total} ({nError} error, \
                  {nImprecise} imprecise, {nSoundness} soundness, {nPass} pass)"
  return nPass

/-- The V1/V2 divergence count: how many V2 goldens differ from (or have no) V1
    counterpart. -/
private def reportDivergence (root : System.FilePath) : IO Unit := do
  let v1Dir := root / "StrataPythonTest" / expectedDirName false
  let v2Dir := root / "StrataPythonTest" / expectedDirName true
  let mut total := 0
  let mut diverging := 0
  for de in ← v2Dir.readDir do
    let fn := de.fileName
    if !fn.endsWith ".expected" || fn.endsWith ".user_errors.expected" then continue
    total := total + 1
    let v1File := v1Dir / fn
    let same ←
      if ← v1File.pathExists then
        pure ((← IO.FS.readBinFile v1File) == (← IO.FS.readBinFile de.path))
      else pure false
    unless same do diverging := diverging + 1
  IO.println ""
  IO.println s!"V1/V2 divergence: {diverging} of {total} golden(s) differ between \
                {expectedDirName false}/ and {expectedDirName true}/."

end StrataPython.AnalyzeGolden.Update

open StrataPython.AnalyzeGolden StrataPython.AnalyzeGolden.Update

public def main (args : List String) : IO UInt32 := do
  let mut v2 := false
  let mut update := false
  let mut pending := false
  let mut checkPending := false
  let mut filter : Option String := none
  let mut vcArgs : Array String := #[]
  let mut rest := args
  while !rest.isEmpty do
    match rest with
    | "--v2" :: t => v2 := true; rest := t
    | "--update" :: t => update := true; rest := t
    | "--pending" :: t => pending := true; rest := t
    | "--check-pending" :: t => pending := true; checkPending := true; rest := t
    | "--filter" :: p :: t => filter := some p; rest := t
    | "--vc-directory" :: d :: t => vcArgs := #["--vc-directory", d]; rest := t
    | [opt@"--filter"] | [opt@"--vc-directory"] =>
      IO.eprintln s!"{opt} requires an argument"; return 1
    | a :: _ => IO.eprintln s!"Unknown option: {a}"; return 1
    | [] => rest := []
  let root ← IO.currentDir
  let python := ((← IO.getEnv "PYTHON").getD "python3")
  let analyzer := analyzerPath root v2
  unless ← analyzer.pathExists do
    IO.eprintln s!"{analyzer} is not built; run `lake build pyAnalyzeLaurel pyAnalyzeV2`"
    return 1
  -- An absolute VC directory, since each case runs from its own scratch directory.
  if vcArgs.size == 2 then
    let d : System.FilePath := vcArgs[1]!
    vcArgs := #["--vc-directory", (if d.isAbsolute then d else root / d).toString]
  let feName := if v2 then "V2" else "V1"
  IO.println s!"Running the {feName} front end ({analyzer.fileName.getD ""})"
  let mut failed := false
  unless ← runGoldens python root v2 update filter vcArgs do failed := true
  if pending then
    let nPass ← runPending python root v2 filter vcArgs
    if checkPending && nPass > 0 then
      IO.println ""
      if v2 then
        IO.println s!"NOTE: {nPass} pending test(s) pass under the V2 front end. Not a \
                      failure: promotion out of tests/pending/ is decided by the V1 run."
      else
        IO.println s!"ERROR: {nPass} pending test(s) now pass. Move them from tests/pending/ \
                      to tests/ and generate expected files with --update."
        failed := true
  if v2 then
    reportDivergence root
  return if failed then 1 else 0
