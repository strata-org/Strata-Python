module
  import loop_invariant: member loop_invariant of pyhard
  import OLD: member OLD of pyhard
  loop_invariant: local (imported)
  OLD: local (imported)
  f: local (assigned)
  function f
    loop_invariant: cell (assigned)
    g: local (assigned, referenced)
    function f.<locals>.g
      loop_invariant: free (assigned, nonlocal)
