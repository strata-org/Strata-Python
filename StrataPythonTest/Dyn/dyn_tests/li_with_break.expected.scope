module
  import loop_invariant: member loop_invariant of pyhard
  import OLD: member OLD of pyhard
  loop_invariant: local (imported)
  OLD: local (imported)
  Ctx: local (assigned)
  f: local (assigned, referenced)
  print: global implicit (referenced)
  class Ctx
    __enter__: local (assigned)
    __exit__: local (assigned)
    function Ctx.__enter__
      params: self
      self: local (parameter, referenced)
    function Ctx.__exit__
      params: self, *a
      self: local (parameter)
      a: local (parameter)
      print: global implicit (referenced)
  function f
    params: n
    n: cell (parameter, referenced)
    i: cell (assigned, referenced)
    loop_invariant: global implicit (referenced)
    Ctx: global implicit (referenced)
    lambda f.<locals>.<lambda>
      i: free (referenced)
      n: free (referenced)
