module top
  OLD: local (imported)
  f: local (assigned, referenced)
  loop_invariant: local (imported)
  print: global implicit (referenced)
  function f
    i: cell (assigned, referenced)
    later: cell (assigned)
    loop_invariant: global implicit (referenced)
    n: cell (parameter, referenced)
    function lambda
      i: free (referenced)
      later: free (referenced)
      n: free (referenced)
qualnames: f, f.<locals>.<lambda>
