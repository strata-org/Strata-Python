module
  import loop_invariant: member loop_invariant of pyhard
  import OLD: member OLD of pyhard
  loop_invariant: local (imported)
  OLD: local (imported)
  g: local (assigned)
  outer: local (assigned, referenced)
  print: global implicit (referenced)
  function outer
    params: k
    k: cell (parameter)
    f: local (assigned, referenced)
    function outer.<locals>.f
      params: n
      n: cell (parameter, referenced)
      i: cell (assigned, referenced)
      loop_invariant: global implicit (referenced)
      k: free
      lambda outer.<locals>.f.<locals>.<lambda>
        i: free (referenced)
        n: free (referenced)
        g: global implicit (referenced)
        k: free (referenced)
