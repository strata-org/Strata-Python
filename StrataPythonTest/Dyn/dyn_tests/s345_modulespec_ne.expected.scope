module
  import builtins: module builtins
  builtins: local (imported, referenced)
  N: local (assigned, referenced)
  s: local (assigned, referenced)
  print: global implicit (referenced)
  class N
    name: local (assigned)
    loader: local (assigned)
    builtins: global implicit (referenced)
    origin: local (assigned)
    submodule_search_locations: local (assigned)
    cached: local (assigned)
    has_location: local (assigned)
