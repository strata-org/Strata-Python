module
  import loop_invariant: member loop_invariant of pyhard
  import OLD: member OLD of pyhard
  loop_invariant: local (imported)
  OLD: local (imported)
  f: local (assigned, referenced)
  print: global implicit (referenced)
  function f
    params: a, /, b, c, *rest, d, e, **kw
    a: cell (parameter)
    b: cell (parameter, assigned, referenced)
    c: cell (parameter)
    d: cell (parameter)
    e: cell (parameter)
    rest: cell (parameter)
    kw: cell (parameter)
    i: local (assigned, referenced)
    loop_invariant: global implicit (referenced)
    lambda f.<locals>.<lambda>
      OLD: global implicit (referenced)
      a: free (referenced)
      b: free (referenced)
      c: free (referenced)
    lambda f.<locals>.<lambda>
      len: global implicit (referenced)
      OLD: global implicit (referenced)
      rest: free (referenced)
      d: free (referenced)
    lambda f.<locals>.<lambda>
      len: global implicit (referenced)
      OLD: global implicit (referenced)
      e: free (referenced)
      kw: free (referenced)
