module top
  OLD: local (imported)
  g: local (assigned)
  loop_invariant: local (imported)
  outer: local (assigned, referenced)
  print: global implicit (referenced)
  function outer
    inner: local (assigned, referenced)
    x: cell (parameter)
    function inner
      i: cell (assigned, referenced)
      loop_invariant: global implicit (referenced)
      n: cell (parameter, referenced)
      x: free
      function lambda
        OLD: global implicit (referenced)
        g: global implicit (referenced)
        i: free (referenced)
        n: free (referenced)
        x: free (referenced)
qualnames: outer, outer.<locals>.inner, outer.<locals>.inner.<locals>.<lambda>
