module
  import loop_invariant: member loop_invariant of pyhard
  import OLD: member OLD of pyhard
  loop_invariant: local (imported)
  OLD: local (imported)
  f: local (assigned, referenced)
  print: global implicit (referenced)
  function f
    params: n
    n: local (parameter, referenced)
    fs: cell (assigned, referenced)
    i: cell (assigned, referenced)
    loop_invariant: global implicit (referenced)
    g: local (assigned, referenced, comp_iter)
    lambda f.<locals>.<lambda>
      len: global implicit (referenced)
      fs: free (referenced)
      i: free (referenced)
    lambda f.<locals>.<lambda>
      i: free (referenced)
    inlined comprehension f.<locals>.<listcomp>
      params: .0
      .0: local (parameter)
      g: local (assigned, referenced, comp_iter)
