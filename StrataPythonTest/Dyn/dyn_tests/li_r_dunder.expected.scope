module
  import loop_invariant: member loop_invariant of pyhard
  import OLD: member OLD of pyhard
  loop_invariant: local (imported)
  OLD: local (imported)
  f: local (assigned)
  function f
    params: xs
    xs: local (parameter, referenced)
    i: local (assigned, referenced)
    loop_invariant: global implicit (referenced)
    len: global implicit (referenced)
    lambda f.<locals>.<lambda>
      __file__: global implicit (referenced)
