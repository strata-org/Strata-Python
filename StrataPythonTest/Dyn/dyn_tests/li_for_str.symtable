module top
  OLD: local (imported)
  f: local (assigned, referenced)
  loop_invariant: local (imported)
  print: global implicit (referenced)
  function f
    c: local (assigned)
    loop_invariant: global implicit (referenced)
    n: cell (assigned, referenced)
    t: cell (parameter, referenced)
    function lambda
      len: global implicit (referenced)
      n: free (referenced)
      t: free (referenced)
qualnames: f, f.<locals>.<lambda>
