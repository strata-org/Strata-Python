module top
  OLD: local (imported)
  f: local (assigned, referenced)
  loop_invariant: local (imported)
  print: global implicit (referenced)
  function f
    i: cell (assigned, referenced)
    loop_invariant: global implicit (referenced)
    n: cell (parameter, referenced)
    xs: cell (parameter)
    function lambda
      i: free (referenced)
      n: free (referenced)
      xs: free (referenced)
    function lambda
      i: free (referenced)
      n: free (referenced)
      xs: free (referenced)
qualnames: f, f.<locals>.<lambda>, f.<locals>.<lambda>
