-- 1.1 ** 2.5: 1.2690587062858836
#guard gives (bin .pow (.float 0x3FF199999999999A) (.float 0x4004000000000000))
  (.float 0x3FF44E1080833B25)
-- 10.0 ** (-5.0): 1e-05
#guard gives (bin .pow (.float 0x4024000000000000) (.float 0xC014000000000000))
  (.float 0x3EE4F8B588E368F1)
-- 3.0 ** 0.3333333333333333: 1.4422495703074083
#guard gives (bin .pow (.float 0x4008000000000000) (.float 0x3FD5555555555555))
  (.float 0x3FF7137449123EF6)
-- 1e-300 ** 0.5: 1e-150
#guard gives (bin .pow (.float 0x01A56E1FC2F8F359) (.float 0x3FE0000000000000))
  (.float 0x20CA2FE76A3F9475)
-- 0.999 ** 100000.0: 3.5385276883431275e-44
#guard gives (bin .pow (.float 0x3FEFF7CED916872B) (.float 0x40F86A0000000000))
  (.float 0x36E940747BB85395)

-- An int operand of a float converts first, ties to even, and can overflow.
-- 9007199254740993 + 0.0: 9007199254740992.0
#guard gives (bin .add (.int 9007199254740993) (.float 0x0000000000000000))
  (.float 0x4340000000000000)
-- 9007199254740995 * 1.0: 9007199254740996.0
#guard gives (bin .mul (.int 9007199254740995) (.float 0x3FF0000000000000))
  (.float 0x4340000000000002)
-- 1.0 + 10**400: OverflowError
#guard raises (bin .add (.float 0x3FF0000000000000) (.int (10 ^ 400))) "OverflowError"
  "int too large to convert to float"
-- 10**400 + 1.0: OverflowError
#guard raises (bin .add (.int (10 ^ 400)) (.float 0x3FF0000000000000)) "OverflowError"
  "int too large to convert to float"
-- (2**1024 - 2**970 - 1) - 0.0: 1.7976931348623157e+308
#guard gives (bin .sub (.int (2 ^ 1024 - 2 ^ 970 - 1)) (.float 0x0000000000000000))
  (.float 0x7FEFFFFFFFFFFFFF)
-- (2**1024 - 2**970) * 1.0: OverflowError
#guard raises (bin .mul (.int (2 ^ 1024 - 2 ^ 970)) (.float 0x3FF0000000000000)) "OverflowError"
  "int too large to convert to float"
-- True + 0.5: 1.5
#guard gives (bin .add (.bool true) (.float 0x3FE0000000000000)) (.float 0x3FF8000000000000)
-- 10**400 // 1.0: OverflowError
#guard raises (bin .floorDiv (.int (10 ^ 400)) (.float 0x3FF0000000000000)) "OverflowError"
  "int too large to convert to float"
-- divmod(10**400, 1.0): OverflowError
#guard raises (divmod (.int (10 ^ 400)) (.float 0x3FF0000000000000)) "OverflowError"
  "int too large to convert to float"
-- 1.0 ** 10**400: OverflowError
#guard raises (bin .pow (.float 0x3FF0000000000000) (.int (10 ^ 400))) "OverflowError"
  "int too large to convert to float"
-- 10**400 ** 0.0: OverflowError
#guard raises (bin .pow (.int (10 ^ 400)) (.float 0x0000000000000000)) "OverflowError"
  "int too large to convert to float"
-- 0.0 / 10**400: OverflowError
#guard raises (bin .trueDiv (.float 0x0000000000000000) (.int (10 ^ 400))) "OverflowError"
  "int too large to convert to float"

-- Floats have no <<, >>, &, | or ^, and an int operand doesn't convert then.
-- 1.0 & 1: TypeError
#guard raises (bin .and (.float 0x3FF0000000000000) (.int 1)) "TypeError"
  "unsupported operand type(s) for &: 'float' and 'int'"
-- 1 & 1.0: TypeError
#guard raises (bin .and (.int 1) (.float 0x3FF0000000000000)) "TypeError"
  "unsupported operand type(s) for &: 'int' and 'float'"
-- 1.0 << 1: TypeError
#guard raises (bin .lshift (.float 0x3FF0000000000000) (.int 1)) "TypeError"
  "unsupported operand type(s) for <<: 'float' and 'int'"
-- 1 >> 1.0: TypeError
#guard raises (bin .rshift (.int 1) (.float 0x3FF0000000000000)) "TypeError"
  "unsupported operand type(s) for >>: 'int' and 'float'"
-- 1.0 | True: TypeError
#guard raises (bin .or (.float 0x3FF0000000000000) (.bool true)) "TypeError"
  "unsupported operand type(s) for |: 'float' and 'bool'"
-- True ^ 1.0: TypeError
#guard raises (bin .xor (.bool true) (.float 0x3FF0000000000000)) "TypeError"
  "unsupported operand type(s) for ^: 'bool' and 'float'"
-- 1.0 & 10**400: TypeError
#guard raises (bin .and (.float 0x3FF0000000000000) (.int (10 ^ 400))) "TypeError"
  "unsupported operand type(s) for &: 'float' and 'int'"
-- 0.5 ^ 0.5: TypeError
#guard raises (bin .xor (.float 0x3FE0000000000000) (.float 0x3FE0000000000000)) "TypeError"
  "unsupported operand type(s) for ^: 'float' and 'float'"
-- ~1.0: TypeError
#guard raises (un .invert (.float 0x3FF0000000000000)) "TypeError"
  "bad operand type for unary ~: 'float'"

-- - flips the sign bit of a float, abs clears it, and + keeps it.
#guard gives (un .neg (.float 0x0000000000000000)) (.float 0x8000000000000000)  -- -0.0: -0.0
#guard gives (un .neg (.float 0x8000000000000000)) (.float 0x0000000000000000)  -- -(-0.0): 0.0
#guard gives (un .abs (.float 0x8000000000000000)) (.float 0x0000000000000000)  -- abs(-0.0): 0.0
#guard gives (un .abs (.float 0xFFF0000000000000)) (.float 0x7FF0000000000000)  -- abs(-inf): inf
#guard gives (un .pos (.float 0x8000000000000000)) (.float 0x8000000000000000)  -- +(-0.0): -0.0
#guard gives (un .neg (.float 0x3FF8000000000000)) (.float 0xBFF8000000000000)  -- -1.5: -1.5
#guard gives (un .neg (.float 0x7FF8000000000000)) (.float 0xFFF8000000000000)  -- -nan: -nan
#guard gives (un .abs (.float 0xFFF8000000000000)) (.float 0x7FF8000000000000)  -- abs(-nan): nan
#guard gives (un .pos (.float 0xFFF8000000000000)) (.float 0xFFF8000000000000)  -- +(-nan): -nan

-- Ints and floats compare exactly, even past 2^53 and 2^1024.
-- 9007199254740993 == 9007199254740992.0: False
#guard compare .eq (.int 9007199254740993) (.float 0x4340000000000000) == false
-- 9007199254740992 == 9007199254740992.0: True
#guard compare .eq (.int 9007199254740992) (.float 0x4340000000000000) == true
-- 9007199254740993 > 9007199254740992.0: True
#guard compare .gt (.int 9007199254740993) (.float 0x4340000000000000) == true
-- 9007199254740993 < 9007199254740994.0: True
#guard compare .lt (.int 9007199254740993) (.float 0x4340000000000001) == true
-- 9007199254740992.0 <= 9007199254740992: True
#guard compare .le (.float 0x4340000000000000) (.int 9007199254740992) == true
-- 1152921504606846977 != 1.152921504606847e+18: True
#guard compare .ne (.int 1152921504606846977) (.float 0x43B0000000000000) == true
-- 10**400 > 1.7976931348623157e+308: True
#guard compare .gt (.int (10 ^ 400)) (.float 0x7FEFFFFFFFFFFFFF) == true
-- (-10**400) < (-1.7976931348623157e+308): True
#guard compare .lt (.int (-(10 ^ 400))) (.float 0xFFEFFFFFFFFFFFFF) == true
-- (2**1024 - 2**970) > 1.7976931348623157e+308: True
#guard compare .gt (.int (2 ^ 1024 - 2 ^ 970)) (.float 0x7FEFFFFFFFFFFFFF) == true
#guard compare .eq (.int 1) (.float 0x3FF0000000000001) == false  -- 1 == 1.0000000000000002: False
#guard compare .lt (.int 1) (.float 0x3FF8000000000000) == true  -- 1 < 1.5: True
#guard compare .gt (.int 2) (.float 0x3FF8000000000000) == true  -- 2 > 1.5: True
#guard compare .lt (.int (-2)) (.float 0xBFF8000000000000) == true  -- (-2) < (-1.5): True
#guard compare .ge (.int 0) (.float 0x0000000000000001) == false  -- 0 >= 5e-324: False
#guard compare .gt (.int 0) (.float 0x8000000000000001) == true  -- 0 > (-5e-324): True

-- Inf is above every int, and -inf below.
#guard compare .gt (.float 0x7FF0000000000000) (.int (10 ^ 400)) == true  -- inf > 10**400: True
-- (-inf) < (-10**400): True
#guard compare .lt (.float 0xFFF0000000000000) (.int (-(10 ^ 400))) == true
#guard compare .lt (.int (10 ^ 400)) (.float 0x7FF0000000000000) == true  -- 10**400 < inf: True
-- inf == inf: True
#guard compare .eq (.float 0x7FF0000000000000) (.float 0x7FF0000000000000) == true
-- (-inf) < inf: True
#guard compare .lt (.float 0xFFF0000000000000) (.float 0x7FF0000000000000) == true
-- (-inf) >= (-inf): True
#guard compare .ge (.float 0xFFF0000000000000) (.float 0xFFF0000000000000) == true
#guard compare .eq (.float 0x7FF0000000000000) (.int (10 ^ 400)) == false  -- inf == 10**400: False

-- A NaN is unequal to everything, itself included, and unordered.
-- nan == nan: False
#guard compare .eq (.float 0x7FF8000000000000) (.float 0x7FF8000000000000) == false
-- nan != nan: True
#guard compare .ne (.float 0x7FF8000000000000) (.float 0x7FF8000000000000) == true
#guard compare .lt (.float 0x7FF8000000000000) (.int 1) == false  -- nan < 1: False
#guard compare .ge (.float 0x7FF8000000000000) (.int 1) == false  -- nan >= 1: False
#guard compare .le (.int 1) (.float 0x7FF8000000000000) == false  -- 1 <= nan: False
#guard compare .eq (.float 0x7FF8000000000000) (.int 0) == false  -- nan == 0: False
#guard compare .ne (.int (10 ^ 400)) (.float 0xFFF8000000000000) == true  -- 10**400 != (-nan): True
-- nan > (-inf): False
#guard compare .gt (.float 0x7FF8000000000000) (.float 0xFFF0000000000000) == false

-- -0.0 equals 0, and bools compare as ints.
#guard compare .eq (.float 0x8000000000000000) (.int 0) == true  -- (-0.0) == 0: True
-- (-0.0) == 0.0: True
#guard compare .eq (.float 0x8000000000000000) (.float 0x0000000000000000) == true
-- (-0.0) < 0.0: False
#guard compare .lt (.float 0x8000000000000000) (.float 0x0000000000000000) == false
#guard compare .eq (.bool true) (.float 0x3FF0000000000000) == true  -- True == 1.0: True
#guard compare .gt (.bool true) (.float 0x3FE0000000000000) == true  -- True > 0.5: True
#guard compare .eq (.bool false) (.int 0) == true  -- False == 0: True
#guard compare .eq (.bool true) (.int 1) == true  -- True == 1: True
#guard compare .lt (.bool true) (.int 2) == true  -- True < 2: True
#guard compare .eq (.bool true) (.bool false) == false  -- True == False: False
#guard compare .le (.bool false) (.float 0x8000000000000000) == true  -- False <= (-0.0): True

-- Int() of a float rounds toward zero.
#guard gives (floatToInt 0x3FFE666666666666) 1  -- int(1.9): 1
#guard gives (floatToInt 0xBFFE666666666666) (-1)  -- int(-1.9): -1
#guard gives (floatToInt 0x8000000000000000) 0  -- int(-0.0): 0
#guard gives (floatToInt 0x3FE0000000000000) 0  -- int(0.5): 0
#guard gives (floatToInt 0x8000000000000001) 0  -- int(-5e-324): 0
-- int(9007199254740994.0): 9007199254740994
#guard gives (floatToInt 0x4340000000000001) 9007199254740994
-- int(1e+20): 100000000000000000000
#guard gives (floatToInt 0x4415AF1D78B58C40) 100000000000000000000
#guard gives (floatToInt 0x7FE0000000000000) (2 ^ 1023)  -- int(8.98846567431158e+307): 2**1023
-- int(1.7976931348623157e+308): (2**53 - 1) * 2**971
#guard gives (floatToInt 0x7FEFFFFFFFFFFFFF) ((2 ^ 53 - 1) * 2 ^ 971)
-- int(-9.223372036854776e+18): -9223372036854775808
#guard gives (floatToInt 0xC3E0000000000000) (-9223372036854775808)

-- Int() of inf and nan.
-- int(inf): OverflowError
#guard raises (floatToInt 0x7FF0000000000000) "OverflowError"
  "cannot convert float infinity to integer"
-- int(-inf): OverflowError
#guard raises (floatToInt 0xFFF0000000000000) "OverflowError"
  "cannot convert float infinity to integer"
-- int(nan): ValueError
#guard raises (floatToInt 0x7FF8000000000000) "ValueError" "cannot convert float NaN to integer"
-- int(-nan): ValueError
#guard raises (floatToInt 0xFFF8000000000000) "ValueError" "cannot convert float NaN to integer"

-- Float() of an int rounds to nearest, ties to even, and overflows from 2^1024 - 2^970.
-- float(9007199254740993): 9007199254740992.0
#guard gives (Num.toFloat (.int 9007199254740993)) 0x4340000000000000
-- float(9007199254740995): 9007199254740996.0
#guard gives (Num.toFloat (.int 9007199254740995)) 0x4340000000000002
-- float(-9223372036854775809): -9.223372036854776e+18
#guard gives (Num.toFloat (.int (-9223372036854775809))) 0xC3E0000000000000
-- float(2**1024 - 2**970 - 1): 1.7976931348623157e+308
#guard gives (Num.toFloat (.int (2 ^ 1024 - 2 ^ 970 - 1))) 0x7FEFFFFFFFFFFFFF
-- float(2**1024 - 2**970): OverflowError
#guard raises (Num.toFloat (.int (2 ^ 1024 - 2 ^ 970))) "OverflowError"
  "int too large to convert to float"
-- float(-10**400): OverflowError
#guard raises (Num.toFloat (.int (-(10 ^ 400)))) "OverflowError" "int too large to convert to float"
#guard gives (Num.toFloat (.bool true)) 0x3FF0000000000000  -- float(True): 1.0
#guard gives (Num.toFloat (.bool false)) 0x0000000000000000  -- float(False): 0.0
#guard gives (Num.toFloat (.int 0)) 0x0000000000000000  -- float(0): 0.0

-- A missing bound of a slice is an end of the sequence, by the sign of the step.
#guard gives (sliceIndices none none none 10) ⟨0, 10, 1, 10⟩  -- [::] of 10: 0, 10, 1, length 10
-- [::-1] of 10: 9, -1, -1, length 10
#guard gives (sliceIndices none none (some (-1)) 10) ⟨9, -1, -1, 10⟩
#guard gives (sliceIndices none none (some 2) 10) ⟨0, 10, 2, 5⟩  -- [::2] of 10: 0, 10, 2, length 5
-- [::-3] of 10: 9, -1, -3, length 4
#guard gives (sliceIndices none none (some (-3)) 10) ⟨9, -1, -3, 4⟩
-- [2::-1] of 10: 2, -1, -1, length 3
#guard gives (sliceIndices (some 2) none (some (-1)) 10) ⟨2, -1, -1, 3⟩
-- [:2:-1] of 10: 9, 2, -1, length 7
#guard gives (sliceIndices none (some 2) (some (-1)) 10) ⟨9, 2, -1, 7⟩

-- Negative indices count from the end, and then are clamped to the sequence.
-- [-3::] of 10: 7, 10, 1, length 3
#guard gives (sliceIndices (some (-3)) none none 10) ⟨7, 10, 1, 3⟩
-- [-20:5:] of 10: 0, 5, 1, length 5
#guard gives (sliceIndices (some (-20)) (some 5) none 10) ⟨0, 5, 1, 5⟩
-- [:-20:-1] of 10: 9, -1, -1, length 10
#guard gives (sliceIndices none (some (-20)) (some (-1)) 10) ⟨9, -1, -1, 10⟩
-- [-20::-1] of 10: -1, -1, -1, length 0
#guard gives (sliceIndices (some (-20)) none (some (-1)) 10) ⟨-1, -1, -1, 0⟩
-- [5:-20:-1] of 10: 5, -1, -1, length 6
#guard gives (sliceIndices (some 5) (some (-20)) (some (-1)) 10) ⟨5, -1, -1, 6⟩
-- [-1:-11:-1] of 10: 9, -1, -1, length 10
#guard gives (sliceIndices (some (-1)) (some (-11)) (some (-1)) 10) ⟨9, -1, -1, 10⟩
-- [-2:-1:] of 10: 8, 9, 1, length 1
#guard gives (sliceIndices (some (-2)) (some (-1)) none 10) ⟨8, 9, 1, 1⟩

-- Indices past the end are clamped to the length, or to the last index for a negative step.
-- [20::] of 10: 10, 10, 1, length 0
#guard gives (sliceIndices (some 20) none none 10) ⟨10, 10, 1, 0⟩
-- [20::-1] of 10: 9, -1, -1, length 10
#guard gives (sliceIndices (some 20) none (some (-1)) 10) ⟨9, -1, -1, 10⟩
-- [3:100:2] of 10: 3, 10, 2, length 4
#guard gives (sliceIndices (some 3) (some 100) (some 2) 10) ⟨3, 10, 2, 4⟩
-- [100:3:-2] of 10: 9, 3, -2, length 3
#guard gives (sliceIndices (some 100) (some 3) (some (-2)) 10) ⟨9, 3, -2, 3⟩
-- [10:10:1] of 10: 10, 10, 1, length 0
#guard gives (sliceIndices (some 10) (some 10) (some 1) 10) ⟨10, 10, 1, 0⟩
-- [9:9:-1] of 10: 9, 9, -1, length 0
#guard gives (sliceIndices (some 9) (some 9) (some (-1)) 10) ⟨9, 9, -1, 0⟩

-- A zero step is a ValueError, whatever the bounds.
-- [::0] of 10: ValueError
#guard raises (sliceIndices none none (some 0) 10) "ValueError" "slice step cannot be zero"
-- [1000000000000000000000000000000::0] of 10: ValueError
#guard raises (sliceIndices (some 1000000000000000000000000000000) none (some 0) 10) "ValueError"
  "slice step cannot be zero"
-- [::0] of 0: ValueError
#guard raises (sliceIndices none none (some 0) 0) "ValueError" "slice step cannot be zero"

-- Huge values are clamped to PY_SSIZE_T_MIN and PY_SSIZE_T_MAX, and a step of PY_SSIZE_T_MIN
-- becomes -PY_SSIZE_T_MAX.
-- [1000000000000000000000000000000:-1000000000000000000000000000000:-1] of 10: 9, -1, -1, length
--   10
#guard gives (sliceIndices (some 1000000000000000000000000000000)
  (some (-1000000000000000000000000000000)) (some (-1)) 10) ⟨9, -1, -1, 10⟩
-- [-1000000000000000000000000000000:1000000000000000000000000000000:] of 10: 0, 10, 1, length 10
#guard gives (sliceIndices (some (-1000000000000000000000000000000))
  (some 1000000000000000000000000000000) none 10) ⟨0, 10, 1, 10⟩
-- [::1000000000000000000000000000000] of 10: 0, 10, 9223372036854775807, length 1
#guard gives (sliceIndices none none (some 1000000000000000000000000000000) 10)
  ⟨0, 10, 9223372036854775807, 1⟩
-- [::-1000000000000000000000000000000] of 10: 9, -1, -9223372036854775807, length 1
#guard gives (sliceIndices none none (some (-1000000000000000000000000000000)) 10)
  ⟨9, -1, -9223372036854775807, 1⟩
-- [::-9223372036854775808] of 10: 9, -1, -9223372036854775807, length 1
#guard gives (sliceIndices none none (some (-9223372036854775808)) 10)
  ⟨9, -1, -9223372036854775807, 1⟩
-- [::-9223372036854775807] of 10: 9, -1, -9223372036854775807, length 1
#guard gives (sliceIndices none none (some (-9223372036854775807)) 10)
  ⟨9, -1, -9223372036854775807, 1⟩
-- [::9223372036854775807] of 9223372036854775807: 0, 9223372036854775807, 9223372036854775807,
--   length 1
#guard gives (sliceIndices none none (some 9223372036854775807) 9223372036854775807)
  ⟨0, 9223372036854775807, 9223372036854775807, 1⟩
-- [-1::-1] of 9223372036854775807: 9223372036854775806, -1, -1, length 9223372036854775807
#guard gives (sliceIndices (some (-1)) none (some (-1)) 9223372036854775807)
  ⟨9223372036854775806, -1, -1, 9223372036854775807⟩
-- [-9223372036854775808:9223372036854775807:1] of 9223372036854775807: 0, 9223372036854775807,
--   1, length 9223372036854775807
#guard gives (sliceIndices (some (-9223372036854775808)) (some 9223372036854775807) (some 1)
  9223372036854775807) ⟨0, 9223372036854775807, 1, 9223372036854775807⟩

-- An empty sequence.
#guard gives (sliceIndices none none none 0) ⟨0, 0, 1, 0⟩  -- [::] of 0: 0, 0, 1, length 0
-- [::-1] of 0: -1, -1, -1, length 0
#guard gives (sliceIndices none none (some (-1)) 0) ⟨-1, -1, -1, 0⟩
#guard gives (sliceIndices (some (-1)) none none 0) ⟨0, 0, 1, 0⟩  -- [-1::] of 0: 0, 0, 1, length 0
-- [5:-5:-2] of 0: -1, -1, -2, length 0
#guard gives (sliceIndices (some 5) (some (-5)) (some (-2)) 0) ⟨-1, -1, -2, 0⟩

-- The length of a slice with a step.
-- [0:10:3] of 10: 0, 10, 3, length 4
#guard gives (sliceIndices (some 0) (some 10) (some 3) 10) ⟨0, 10, 3, 4⟩
-- [9::-4] of 10: 9, -1, -4, length 3
#guard gives (sliceIndices (some 9) none (some (-4)) 10) ⟨9, -1, -4, 3⟩
-- [1:2:9223372036854775807] of 10: 1, 2, 9223372036854775807, length 1
#guard gives (sliceIndices (some 1) (some 2) (some 9223372036854775807) 10)
  ⟨1, 2, 9223372036854775807, 1⟩
-- [0:9:3] of 10: 0, 9, 3, length 3
#guard gives (sliceIndices (some 0) (some 9) (some 3) 10) ⟨0, 9, 3, 3⟩
-- [0:10:9] of 10: 0, 10, 9, length 2
#guard gives (sliceIndices (some 0) (some 10) (some 9) 10) ⟨0, 10, 9, 2⟩
-- [8:0:-3] of 10: 8, 0, -3, length 3
#guard gives (sliceIndices (some 8) (some 0) (some (-3)) 10) ⟨8, 0, -3, 3⟩

/-! ## Ints with more than 2 ^ 32 bits, which are not modelled -/

-- A shift whose result has 2^32 + 1 bits.
-- 1 << 4294967296: not modelled
#guard unmodelled (bin .lshift (.int 1) (.int 4294967296)) "an int with more than 2 ^ 32 bits"
-- (-1099511627776) << 4294967256: not modelled
#guard unmodelled (bin .lshift (.int (-1099511627776)) (.int 4294967256))
  "an int with more than 2 ^ 32 bits"

-- A power whose result has 2^32 + 1 bits.
-- 2 ** 4294967296: not modelled
#guard unmodelled (bin .pow (.int 2) (.int 4294967296)) "an int with more than 2 ^ 32 bits"
-- 4 ** 2147483648: not modelled
#guard unmodelled (bin .pow (.int 4) (.int 2147483648)) "an int with more than 2 ^ 32 bits"

-- A power with e * floor(log2 |a|) = 2^32, whose result has more than 2^32 bits.
-- 3 ** 4294967296: not modelled
#guard unmodelled (bin .pow (.int 3) (.int 4294967296)) "an int with more than 2 ^ 32 bits"
-- (-2) ** 1000000000000000000000000000000: not modelled
#guard unmodelled (bin .pow (.int (-2)) (.int 1000000000000000000000000000000))
  "an int with more than 2 ^ 32 bits"

