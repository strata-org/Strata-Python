module
public import StrataPython.Dyn.Sem.Arith
-- The `#guard`s below run as compiled code.
meta import StrataPython.Dyn.Sem.Arith

set_option autoImplicit false

/-!
# Arithmetic on ints, bools and floats

Generated by `gen_arith_cases.py`; do not edit.  Each expected result or exception is what CPython
3.12.15 gives for the same case: a binary operator, a unary operator or `abs`, `divmod`, a
comparison, `int()` of a float, `float()` of an int, or the indices of a slice, which come from
CPython's `PySlice_Unpack` and `PySlice_AdjustIndices`.  "Not modelled" stands for CPython's
`MemoryError`, for an int with more than `2 ^ 32` bits, and for a complex power, which CPython
computes or finds too large ("complex exponentiation").  A float is given by its bits, a NaN too,
as CPython's `float_add` and the other slots of `float` give them on x86-64; the comment of each
case shows it as Python writes it.  First come the corner cases, each group with what it shows,
then the results that are too large, then random cases.
-/

namespace StrataPython.Dyn.Sem.ArithTest

open StrataPython.Dyn.Sem.Format
open StrataPython.Dyn.Sem.Arith

/-- `r` is the result `x`. -/
def gives {α : Type} [BEq α] (r : Except Failure α) (x : α) : Bool := r.toOption == some x

/-- `r` is CPython raising the exception class `cls` with the message `msg`. -/
def raises {α : Type} (r : Except Failure α) (cls msg : String) : Bool :=
  match r with
  | .error e => e == .raise cls msg
  | .ok _ => false

/-- `r` is a case that the port doesn't model, for the reason `why`. -/
def unmodelled {α : Type} (r : Except Failure α) (why : String) : Bool :=
  match r with
  | .error (.notModelled w) => w == why
  | _ => false

/-- The name of the type of the number `x`. -/
def typeName : Num → String
  | .bool _ => "bool"
  | .int _ => "int"
  | .float _ => "float"

/-- The symbol of the binary operator `op`. -/
def symbol : BinOp → String
  | .add => "+" | .sub => "-" | .mul => "*" | .trueDiv => "/" | .floorDiv => "//" | .mod => "%"
  | .pow => "** or pow()" | .lshift => "<<" | .rshift => ">>" | .and => "&" | .or => "|"
  | .xor => "^"

/-- `a op b`, with CPython's `TypeError` when no slot implements `op` for the operands. -/
def bin (op : BinOp) (a b : Num) : Except Failure Num :=
  (binary op a b).getD (.error (.raise "TypeError"
    s!"unsupported operand type(s) for {symbol op}: '{typeName a}' and '{typeName b}'"))

/-- `op a`, with CPython's `TypeError` for `~` on a float. -/
def un (op : UnaryOp) (a : Num) : Except Failure Num :=
  match unary op a with
  | some r => r
  | none => .error (.raise "TypeError" s!"bad operand type for unary ~: '{typeName a}'")

/-! ## Corner cases -/

-- Int true division decides a huge or a tiny quotient from the bit lengths first.
-- 2**3000 / 3: OverflowError
#guard raises (bin .trueDiv (.int (2 ^ 3000)) (.int 3)) "OverflowError"
  "integer division result too large for a float"
-- 2**1100 / 37778931862957161709568: OverflowError
#guard raises (bin .trueDiv (.int (2 ^ 1100)) (.int 37778931862957161709568)) "OverflowError"
  "integer division result too large for a float"
-- 2**1100 / 75557863725914323419136: OverflowError
#guard raises (bin .trueDiv (.int (2 ^ 1100)) (.int 75557863725914323419136)) "OverflowError"
  "integer division result too large for a float"
-- 1 / 2**3000: 0.0
#guard gives (bin .trueDiv (.int 1) (.int (2 ^ 3000))) (.float 0x0000000000000000)
-- (-1) / 2**3000: -0.0
#guard gives (bin .trueDiv (.int (-1)) (.int (2 ^ 3000))) (.float 0x8000000000000000)
-- 3 / 2**1077: 0.0
#guard gives (bin .trueDiv (.int 3) (.int (2 ^ 1077))) (.float 0x0000000000000000)
-- 3 / 2**1076: 5e-324
#guard gives (bin .trueDiv (.int 3) (.int (2 ^ 1076))) (.float 0x0000000000000001)
-- 2**3000 / 2**2990: 1024.0
#guard gives (bin .trueDiv (.int (2 ^ 3000)) (.int (2 ^ 2990))) (.float 0x4090000000000000)
-- 0 / (-(2**3000)): -0.0
#guard gives (bin .trueDiv (.int 0) (.int (-(2 ^ 3000)))) (.float 0x8000000000000000)

-- An int far beyond a float's range overflows when it converts.
-- 2**5000 + 0.5: OverflowError
#guard raises (bin .add (.int (2 ^ 5000)) (.float 0x3FE0000000000000)) "OverflowError"
  "int too large to convert to float"
-- (-(2**5000)) * 1.0: OverflowError
#guard raises (bin .mul (.int (-(2 ^ 5000))) (.float 0x3FF0000000000000)) "OverflowError"
  "int too large to convert to float"
-- 2**5000 / 3.0: OverflowError
#guard raises (bin .trueDiv (.int (2 ^ 5000)) (.float 0x4008000000000000)) "OverflowError"
  "int too large to convert to float"
#guard compare .lt (.int (2 ^ 5000)) (.float 0x7FF0000000000000) == true  -- 2**5000 < inf: True

-- +, - and * of ints are exact, at any size.
-- 18446744073709551616 + 18446744073709551616: 36893488147419103232
#guard gives (bin .add (.int 18446744073709551616) (.int 18446744073709551616))
  (.int 36893488147419103232)
-- (-1267650600228229401496703205376) - 1: -1267650600228229401496703205377
#guard gives (bin .sub (.int (-1267650600228229401496703205376)) (.int 1))
  (.int (-1267650600228229401496703205377))
-- 18446744073709551617 * (-18446744073709551615): -340282366920938463463374607431768211455
#guard gives (bin .mul (.int 18446744073709551617) (.int (-18446744073709551615)))
  (.int (-340282366920938463463374607431768211455))
-- 3**200 * 3**200: 3**400
#guard gives (bin .mul (.int (3 ^ 200)) (.int (3 ^ 200))) (.int (3 ^ 400))

-- // takes the floor, and % the sign of the divisor.
#guard gives (bin .floorDiv (.int 7) (.int 2)) (.int 3)  -- 7 // 2: 3
#guard gives (bin .floorDiv (.int (-7)) (.int 2)) (.int (-4))  -- (-7) // 2: -4
#guard gives (bin .floorDiv (.int 7) (.int (-2))) (.int (-4))  -- 7 // (-2): -4
#guard gives (bin .floorDiv (.int (-7)) (.int (-2))) (.int 3)  -- (-7) // (-2): 3
#guard gives (bin .mod (.int 7) (.int 2)) (.int 1)  -- 7 % 2: 1
#guard gives (bin .mod (.int (-7)) (.int 2)) (.int 1)  -- (-7) % 2: 1
#guard gives (bin .mod (.int 7) (.int (-2))) (.int (-1))  -- 7 % (-2): -1
#guard gives (bin .mod (.int (-7)) (.int (-2))) (.int (-1))  -- (-7) % (-2): -1
#guard gives (bin .floorDiv (.int 0) (.int (-5))) (.int 0)  -- 0 // (-5): 0
#guard gives (bin .mod (.int 0) (.int (-5))) (.int 0)  -- 0 % (-5): 0
-- (-1000000000000000000000000000000) % 7: 6
#guard gives (bin .mod (.int (-1000000000000000000000000000000)) (.int 7)) (.int 6)
-- 10000000000000000000000000000000000000001 // (-100000000000000000000): -100000000000000000001
#guard gives (bin .floorDiv (.int 10000000000000000000000000000000000000001)
  (.int (-100000000000000000000))) (.int (-100000000000000000001))
#guard gives (divmod (.int (-7)) (.int 2)) (.int (-4), .int 1)  -- divmod(-7, 2): (-4, 1)
-- divmod(1000000000000000000000000000000, -2305843009213693951): (-433680868995,
--   -1840584323654949245)
#guard gives (divmod (.int 1000000000000000000000000000000) (.int (-2305843009213693951)))
  (.int (-433680868995), .int (-1840584323654949245))

-- The zero divisions of ints, each with its message.
-- 1 // 0: ZeroDivisionError
#guard raises (bin .floorDiv (.int 1) (.int 0)) "ZeroDivisionError"
  "integer division or modulo by zero"
-- 1 % 0: ZeroDivisionError
#guard raises (bin .mod (.int 1) (.int 0)) "ZeroDivisionError" "integer modulo by zero"
-- divmod(1, 0): ZeroDivisionError
#guard raises (divmod (.int 1) (.int 0)) "ZeroDivisionError" "integer division or modulo by zero"
-- 1 / 0: ZeroDivisionError
#guard raises (bin .trueDiv (.int 1) (.int 0)) "ZeroDivisionError" "division by zero"
-- 0 / 0: ZeroDivisionError
#guard raises (bin .trueDiv (.int 0) (.int 0)) "ZeroDivisionError" "division by zero"
-- True % False: ZeroDivisionError
#guard raises (bin .mod (.bool true) (.bool false)) "ZeroDivisionError" "integer modulo by zero"
-- 10**400 / 0: ZeroDivisionError
#guard raises (bin .trueDiv (.int (10 ^ 400)) (.int 0)) "ZeroDivisionError" "division by zero"

-- Int true division rounds correctly, ties to even, with the sign of the product.
-- 1 / 3: 0.3333333333333333
#guard gives (bin .trueDiv (.int 1) (.int 3)) (.float 0x3FD5555555555555)
-- (-2) / 3: -0.6666666666666666
#guard gives (bin .trueDiv (.int (-2)) (.int 3)) (.float 0xBFE5555555555555)
-- 9007199254740993 / 1: 9007199254740992.0
#guard gives (bin .trueDiv (.int 9007199254740993) (.int 1)) (.float 0x4340000000000000)
-- 9007199254740995 / 1: 9007199254740996.0
#guard gives (bin .trueDiv (.int 9007199254740995) (.int 1)) (.float 0x4340000000000002)
-- 18014398509481985 / 2: 9007199254740992.0
#guard gives (bin .trueDiv (.int 18014398509481985) (.int 2)) (.float 0x4340000000000000)
-- 18014398509481987 / 2: 9007199254740994.0
#guard gives (bin .trueDiv (.int 18014398509481987) (.int 2)) (.float 0x4340000000000001)
-- 18014398509481987 / (-2): -9007199254740994.0
#guard gives (bin .trueDiv (.int 18014398509481987) (.int (-2))) (.float 0xC340000000000001)
-- 1000000000000000000000000000000 / 7: 1.4285714285714285e+29
#guard gives (bin .trueDiv (.int 1000000000000000000000000000000) (.int 7))
  (.float 0x45FCD98A8B00A10B)
-- 10**400 / 10**100: 1e+300
#guard gives (bin .trueDiv (.int (10 ^ 400)) (.int (10 ^ 100))) (.float 0x7E37E43C8800759C)
#guard gives (bin .trueDiv (.int 0) (.int (-5))) (.float 0x8000000000000000)  -- 0 / (-5): -0.0
-- (-1) / 10**400: -0.0
#guard gives (bin .trueDiv (.int (-1)) (.int (10 ^ 400))) (.float 0x8000000000000000)

-- Int true division down to the subnormals: 2^-1075 is a tie, which rounds to 0.
-- 1 / 2**1074: 5e-324
#guard gives (bin .trueDiv (.int 1) (.int (2 ^ 1074))) (.float 0x0000000000000001)
-- 1 / 2**1075: 0.0
#guard gives (bin .trueDiv (.int 1) (.int (2 ^ 1075))) (.float 0x0000000000000000)
-- 3 / 2**1076: 5e-324
#guard gives (bin .trueDiv (.int 3) (.int (2 ^ 1076))) (.float 0x0000000000000001)
-- 1 / (2**1075 - 1): 5e-324
#guard gives (bin .trueDiv (.int 1) (.int (2 ^ 1075 - 1))) (.float 0x0000000000000001)
-- (-1) / (2**1075 + 1): -0.0
#guard gives (bin .trueDiv (.int (-1)) (.int (2 ^ 1075 + 1))) (.float 0x8000000000000000)
-- 4503599627370497 / 2**1127: 5e-324
#guard gives (bin .trueDiv (.int 4503599627370497) (.int (2 ^ 1127))) (.float 0x0000000000000001)

-- Int true division overflows when the result rounds to 2^1024.
-- 2**1024 / 1: OverflowError
#guard raises (bin .trueDiv (.int (2 ^ 1024)) (.int 1)) "OverflowError"
  "integer division result too large for a float"
-- (2**1024 - 2**970) / 1: OverflowError
#guard raises (bin .trueDiv (.int (2 ^ 1024 - 2 ^ 970)) (.int 1)) "OverflowError"
  "integer division result too large for a float"
-- (2**1024 - 2**970 - 1) / 1: 1.7976931348623157e+308
#guard gives (bin .trueDiv (.int (2 ^ 1024 - 2 ^ 970 - 1)) (.int 1)) (.float 0x7FEFFFFFFFFFFFFF)
-- (-2**2000) / 2**976: OverflowError
#guard raises (bin .trueDiv (.int (-(2 ^ 2000))) (.int (2 ^ 976))) "OverflowError"
  "integer division result too large for a float"
-- 10**400 / 10**90: OverflowError
#guard raises (bin .trueDiv (.int (10 ^ 400)) (.int (10 ^ 90))) "OverflowError"
  "integer division result too large for a float"

-- ** of ints is exact for an exponent that is not negative.
#guard gives (bin .pow (.int 2) (.int 10)) (.int 1024)  -- 2 ** 10: 1024
#guard gives (bin .pow (.int (-2)) (.int 3)) (.int (-8))  -- (-2) ** 3: -8
#guard gives (bin .pow (.int 0) (.int 0)) (.int 1)  -- 0 ** 0: 1
#guard gives (bin .pow (.int (-3)) (.int 0)) (.int 1)  -- (-3) ** 0: 1
#guard gives (bin .pow (.int 0) (.int 5)) (.int 0)  -- 0 ** 5: 0
#guard gives (bin .pow (.int 3) (.int 200)) (.int (3 ^ 200))  -- 3 ** 200: 3**200
-- (-7) ** 41: -44567640326363195900190045974568007
#guard gives (bin .pow (.int (-7)) (.int 41)) (.int (-44567640326363195900190045974568007))
#guard gives (bin .pow (.int 2) (.int 1000000)) (.int (2 ^ 1000000))  -- 2 ** 1000000: 2**1000000

-- 0, 1 and -1 to a huge power.
#guard gives (bin .pow (.int 1) (.int (10 ^ 100))) (.int 1)  -- 1 ** 10**100: 1
#guard gives (bin .pow (.int (-1)) (.int (10 ^ 100))) (.int 1)  -- (-1) ** 10**100: 1
#guard gives (bin .pow (.int (-1)) (.int (10 ^ 100 + 1))) (.int (-1))  -- (-1) ** (10**100 + 1): -1
#guard gives (bin .pow (.int 0) (.int (10 ^ 100))) (.int 0)  -- 0 ** 10**100: 0

-- A negative exponent makes ** a pow of floats; 0 to a negative power is an error.
#guard gives (bin .pow (.int 2) (.int (-1))) (.float 0x3FE0000000000000)  -- 2 ** (-1): 0.5
#guard gives (bin .pow (.int (-8)) (.int (-1))) (.float 0xBFC0000000000000)  -- (-8) ** (-1): -0.125
#guard gives (bin .pow (.int 10) (.int (-5))) (.float 0x3EE4F8B588E368F1)  -- 10 ** (-5): 1e-05
-- 0 ** (-1): ZeroDivisionError
#guard raises (bin .pow (.int 0) (.int (-1))) "ZeroDivisionError"
  "0.0 cannot be raised to a negative power"
#guard gives (bin .pow (.int 7) (.int (-400))) (.float 0x0000000000000000)  -- 7 ** (-400): 0.0
-- (-2) ** (-1075): -0.0
#guard gives (bin .pow (.int (-2)) (.int (-1075))) (.float 0x8000000000000000)
-- 2 ** (-2**1000): 0.0
#guard gives (bin .pow (.int 2) (.int (-(2 ^ 1000)))) (.float 0x0000000000000000)
-- 10**400 ** (-1): OverflowError
#guard raises (bin .pow (.int (10 ^ 400)) (.int (-1))) "OverflowError"
  "int too large to convert to float"
-- 2 ** (-10**400): OverflowError
#guard raises (bin .pow (.int 2) (.int (-(10 ^ 400)))) "OverflowError"
  "int too large to convert to float"

-- Shifts by a negative count are a ValueError, even for 0.
-- 1 << (-1): ValueError
#guard raises (bin .lshift (.int 1) (.int (-1))) "ValueError" "negative shift count"
-- 0 << (-1): ValueError
#guard raises (bin .lshift (.int 0) (.int (-1))) "ValueError" "negative shift count"
-- 1 >> (-1): ValueError
#guard raises (bin .rshift (.int 1) (.int (-1))) "ValueError" "negative shift count"
-- 0 >> (-1000000000000000000000000000000): ValueError
#guard raises (bin .rshift (.int 0) (.int (-1000000000000000000000000000000))) "ValueError"
  "negative shift count"

-- << and >> are a multiplication and a floor division by a power of 2.
-- 1 << 100: 1267650600228229401496703205376
#guard gives (bin .lshift (.int 1) (.int 100)) (.int 1267650600228229401496703205376)
-- (-3) << 70: -3541774862152233910272
#guard gives (bin .lshift (.int (-3)) (.int 70)) (.int (-3541774862152233910272))
#guard gives (bin .rshift (.int (-5)) (.int 1)) (.int (-3))  -- (-5) >> 1: -3
#guard gives (bin .rshift (.int 5) (.int 1)) (.int 2)  -- 5 >> 1: 2
-- (-1267650600228229401496703205376) >> 99: -2
#guard gives (bin .rshift (.int (-1267650600228229401496703205376)) (.int 99)) (.int (-2))
-- (-1267650600228229401496703205377) >> 100: -2
#guard gives (bin .rshift (.int (-1267650600228229401496703205377)) (.int 100)) (.int (-2))
-- 0 << 1000000000000000000000000000000: 0
#guard gives (bin .lshift (.int 0) (.int 1000000000000000000000000000000)) (.int 0)
#guard gives (bin .lshift (.int 1) (.int 1000000)) (.int (2 ^ 1000000))  -- 1 << 1000000: 2**1000000

-- >> by a huge count gives 0 or -1.
-- 5 >> 1000000000000000000000000000000: 0
#guard gives (bin .rshift (.int 5) (.int 1000000000000000000000000000000)) (.int 0)
-- (-5) >> 1000000000000000000000000000000: -1
#guard gives (bin .rshift (.int (-5)) (.int 1000000000000000000000000000000)) (.int (-1))
-- (-1) >> 9223372036854775808: -1
#guard gives (bin .rshift (.int (-1)) (.int 9223372036854775808)) (.int (-1))
-- 1267650600228229401496703205376 >> 18446744073709551616: 0
#guard gives (bin .rshift (.int 1267650600228229401496703205376) (.int 18446744073709551616))
  (.int 0)

-- << by a huge count: OverflowError past the most digits of an int, else MemoryError.
-- 1 << 73786976294838206464: OverflowError
#guard raises (bin .lshift (.int 1) (.int 73786976294838206464)) "OverflowError"
  "too many digits in integer"
-- 1 << 69175290276410818320: not modelled
#guard unmodelled (bin .lshift (.int 1) (.int 69175290276410818320))
  "an int with more than 2 ^ 32 bits"
-- 1073741824 << 69175290276410818320: OverflowError
#guard raises (bin .lshift (.int 1073741824) (.int 69175290276410818320)) "OverflowError"
  "too many digits in integer"
-- (-1) << 9223372036854775808: not modelled
#guard unmodelled (bin .lshift (.int (-1)) (.int 9223372036854775808))
  "an int with more than 2 ^ 32 bits"
-- 1 << 4611686018427387904: not modelled
#guard unmodelled (bin .lshift (.int 1) (.int 4611686018427387904))
  "an int with more than 2 ^ 32 bits"

-- &, | and ^ treat negative ints as two's complement.
#guard gives (bin .and (.int (-6)) (.int 5)) (.int 0)  -- (-6) & 5: 0
#guard gives (bin .or (.int (-6)) (.int 5)) (.int (-1))  -- (-6) | 5: -1
#guard gives (bin .xor (.int (-6)) (.int 5)) (.int (-1))  -- (-6) ^ 5: -1
#guard gives (bin .and (.int 5) (.int (-6))) (.int 0)  -- 5 & (-6): 0
#guard gives (bin .or (.int 5) (.int (-6))) (.int (-1))  -- 5 | (-6): -1
#guard gives (bin .xor (.int 5) (.int (-6))) (.int (-1))  -- 5 ^ (-6): -1
#guard gives (bin .and (.int (-6)) (.int (-5))) (.int (-6))  -- (-6) & (-5): -6
#guard gives (bin .or (.int (-6)) (.int (-5))) (.int (-5))  -- (-6) | (-5): -5
#guard gives (bin .xor (.int (-6)) (.int (-5))) (.int 1)  -- (-6) ^ (-5): 1
-- 1267650600228229401496703205383 & (-1): 1267650600228229401496703205383
#guard gives (bin .and (.int 1267650600228229401496703205383) (.int (-1)))
  (.int 1267650600228229401496703205383)
-- (-1267650600228229401496703205376) | 1267650600228229401496703205375: -1
#guard gives (bin .or (.int (-1267650600228229401496703205376))
  (.int 1267650600228229401496703205375)) (.int (-1))
-- (-1) ^ 1180591620717411303424: -1180591620717411303425
#guard gives (bin .xor (.int (-1)) (.int 1180591620717411303424)) (.int (-1180591620717411303425))

-- ~, - and abs of ints.
#guard gives (un .invert (.int 0)) (.int (-1))  -- ~0: -1
#guard gives (un .invert (.int (-1))) (.int 0)  -- ~(-1): 0
-- ~1267650600228229401496703205376: -1267650600228229401496703205377
#guard gives (un .invert (.int 1267650600228229401496703205376))
  (.int (-1267650600228229401496703205377))
-- -(-1267650600228229401496703205376): 1267650600228229401496703205376
#guard gives (un .neg (.int (-1267650600228229401496703205376)))
  (.int 1267650600228229401496703205376)
-- abs(-1267650600228229401496703205376): 1267650600228229401496703205376
#guard gives (un .abs (.int (-1267650600228229401496703205376)))
  (.int 1267650600228229401496703205376)
#guard gives (un .pos (.int (-5))) (.int (-5))  -- +(-5): -5

-- Bools act as ints, but &, | and ^ of two bools give a bool.
#guard gives (bin .add (.bool true) (.bool true)) (.int 2)  -- True + True: 2
#guard gives (bin .and (.bool true) (.bool true)) (.bool true)  -- True & True: True
#guard gives (bin .and (.bool true) (.bool false)) (.bool false)  -- True & False: False
#guard gives (bin .or (.bool false) (.bool false)) (.bool false)  -- False | False: False
#guard gives (bin .xor (.bool true) (.bool true)) (.bool false)  -- True ^ True: False
#guard gives (bin .xor (.bool true) (.bool false)) (.bool true)  -- True ^ False: True
#guard gives (bin .and (.bool true) (.int 1)) (.int 1)  -- True & 1: 1
#guard gives (bin .and (.int 1) (.bool true)) (.int 1)  -- 1 & True: 1
#guard gives (bin .or (.bool false) (.int 0)) (.int 0)  -- False | 0: 0
#guard gives (bin .sub (.bool false) (.bool true)) (.int (-1))  -- False - True: -1
#guard gives (bin .mul (.bool true) (.int (-5))) (.int (-5))  -- True * (-5): -5

-- Other operators on bools give ints or floats; ~ on a bool is not modelled.
#guard unmodelled (un .invert (.bool true)) "~ on a bool, which warns"  -- ~True: not modelled
#guard unmodelled (un .invert (.bool false)) "~ on a bool, which warns"  -- ~False: not modelled
#guard gives (un .neg (.bool true)) (.int (-1))  -- -True: -1
#guard gives (un .pos (.bool true)) (.int 1)  -- +True: 1
#guard gives (un .abs (.bool false)) (.int 0)  -- abs(False): 0
-- True / True: 1.0
#guard gives (bin .trueDiv (.bool true) (.bool true)) (.float 0x3FF0000000000000)
#guard gives (bin .floorDiv (.bool true) (.bool true)) (.int 1)  -- True // True: 1
#guard gives (bin .mod (.bool true) (.bool true)) (.int 0)  -- True % True: 0
#guard gives (bin .pow (.bool true) (.int (-1))) (.float 0x3FF0000000000000)  -- True ** (-1): 1.0
#guard gives (bin .pow (.bool false) (.int 0)) (.int 1)  -- False ** 0: 1
#guard gives (bin .lshift (.bool true) (.int 3)) (.int 8)  -- True << 3: 8
#guard gives (divmod (.bool true) (.bool true)) (.int 1, .int 0)  -- divmod(True, True): (1, 0)

-- +, -, * and / of floats round to nearest, ties to even, and overflow to inf.
-- 0.1 + 0.2: 0.30000000000000004
#guard gives (bin .add (.float 0x3FB999999999999A) (.float 0x3FC999999999999A))
  (.float 0x3FD3333333333334)
-- 1e+308 * 10.0: inf
#guard gives (bin .mul (.float 0x7FE1CCF385EBC8A0) (.float 0x4024000000000000))
  (.float 0x7FF0000000000000)
-- (-1e+308) - 1e+308: -inf
#guard gives (bin .sub (.float 0xFFE1CCF385EBC8A0) (.float 0x7FE1CCF385EBC8A0))
  (.float 0xFFF0000000000000)
-- 1.0 / 3.0: 0.3333333333333333
#guard gives (bin .trueDiv (.float 0x3FF0000000000000) (.float 0x4008000000000000))
  (.float 0x3FD5555555555555)
-- 5e-324 / 2.0: 0.0
#guard gives (bin .trueDiv (.float 0x0000000000000001) (.float 0x4000000000000000))
  (.float 0x0000000000000000)
-- 1e-323 / 2.0: 5e-324
#guard gives (bin .trueDiv (.float 0x0000000000000002) (.float 0x4000000000000000))
  (.float 0x0000000000000001)
-- 1e-200 * 1e-200: 0.0
#guard gives (bin .mul (.float 0x16687E92154EF7AC) (.float 0x16687E92154EF7AC))
  (.float 0x0000000000000000)
-- 9007199254740992.0 + 1.0: 9007199254740992.0
#guard gives (bin .add (.float 0x4340000000000000) (.float 0x3FF0000000000000))
  (.float 0x4340000000000000)
-- 9007199254740992.0 + 3.0: 9007199254740996.0
#guard gives (bin .add (.float 0x4340000000000000) (.float 0x4008000000000000))
  (.float 0x4340000000000002)

-- Signed zeros.
-- (-0.0) + 0.0: 0.0
#guard gives (bin .add (.float 0x8000000000000000) (.float 0x0000000000000000))
  (.float 0x0000000000000000)
