-- Alignments of a str; centering puts the extra fill on the right.
#guard gives (formatStr "abc" "") "abc"
#guard gives (formatStr "abc" "^7") "  abc  "
#guard gives (formatStr "abc" "*^8") "**abc***"
#guard gives (formatStr "abc" ">5") "  abc"

-- A precision truncates a str.
#guard gives (formatStr "abcdef" ".2") "ab"
#guard gives (formatStr "abcdef" "5.2") "ab   "

-- Widths count code points.
#guard gives (formatStr "中😀é" "x^8") "xx中😀éxxx"

