/-! ## Corner cases -/

-- Repr of an int.
#guard gives (formatInt 0 "") "0"
#guard gives (formatInt (-1000000000000000000000000000000) "") "-1000000000000000000000000000000"

-- An int with more than 4300 digits has no repr: ValueError; the sign doesn't count.
#guard raises (formatInt (10 ^ 4300) "") "ValueError"
  "Exceeds the limit (4300 digits) for integer string conversion; use sys.set_int_max_str_digits() to increase the limit"
#guard gives (formatInt (10 ^ 4300 - 1) "") (String.ofList (List.replicate 4300 '9'))
#guard gives (formatInt (-(10 ^ 4300 - 1)) "") ("-" ++ String.ofList (List.replicate 4300 '9'))
#guard raises (formatInt (2 ^ 14400) "") "ValueError"
  "Exceeds the limit (4300 digits) for integer string conversion; use sys.set_int_max_str_digits() to increase the limit"

-- The limit on digits is for decimal digits only.
#guard gives (formatInt (2 ^ 14400) "x") ("1" ++ String.ofList (List.replicate 3600 '0'))
#guard raises (formatInt (10 ^ 4300) "d") "ValueError"
  "Exceeds the limit (4300 digits) for integer string conversion; use sys.set_int_max_str_digits() to increase the limit"
#guard raises (formatInt (10 ^ 4300) ",") "ValueError"
  "Exceeds the limit (4300 digits) for integer string conversion; use sys.set_int_max_str_digits() to increase the limit"

-- Repr of a float; a NaN has no sign.
#guard gives (formatFloat 0x0000000000000000 "") "0.0"  -- 0.0
#guard gives (formatFloat 0x8000000000000000 "") "-0.0"  -- -0.0
#guard gives (formatFloat 0x7FF0000000000000 "") "inf"  -- inf
#guard gives (formatFloat 0xFFF0000000000000 "") "-inf"  -- -inf
#guard gives (formatFloat 0xFFF8000000000000 "") "nan"  -- nan

-- Repr has an exponent from 1e16 on and below 1e-4.
#guard gives (formatFloat 0x4341C37937E08000 "") "1e+16"  -- 1e+16
#guard gives (formatFloat 0x4341C37937E07FFF "") "9999999999999998.0"  -- 9999999999999998.0
#guard gives (formatFloat 0x3EE4F8B588E368F1 "") "1e-05"  -- 1e-05
#guard gives (formatFloat 0x3F1A36E2EB1C432D "") "0.0001"  -- 0.0001
#guard gives (formatFloat 0x405EC00000000000 "") "123.0"  -- 123.0

-- Repr has the shortest digits that read back as the float.
#guard gives (formatFloat 0x3FB999999999999A "") "0.1"  -- 0.1
#guard gives (formatFloat 0x3FD5555555555555 "") "0.3333333333333333"  -- 0.3333333333333333
#guard gives (formatFloat 0x0000000000000001 "") "5e-324"  -- 5e-324
#guard gives (formatFloat 0x7FEFFFFFFFFFFFFF "")  -- 1.7976931348623157e+308
  "1.7976931348623157e+308"
#guard gives (formatFloat 0x4351C37937E08002 "") "2.000000000000001e+16"  -- 2.000000000000001e+16

-- Specs that don't parse.
#guard raises (formatInt 1 "xx") "ValueError"
  "Invalid format specifier 'xx' for object of type 'int'"
#guard raises (formatInt 1 "1.") "ValueError" "Format specifier missing precision"
#guard raises (formatInt 1 ",_") "ValueError" "Cannot specify both ',' and '_'."
#guard raises (formatInt 1 "_,") "ValueError" "Cannot specify both ',' and '_'."
#guard raises (formatInt 1 "9223372036854775808") "ValueError"
  "Too many decimal digits in format string"
#guard raises (formatFloat 0x3FF0000000000000 ".9223372036854775808") "ValueError"  -- 1.0
  "Too many decimal digits in format string"

-- The second ',' is the type.
#guard raises (formatInt 1 ",,") "ValueError" "Cannot specify ',' with ','."

-- A width at PY_SSIZE_T_MAX is read, and CPython raises MemoryError.
#guard unmodelled (formatInt 1 "9223372036854775807x")

-- Widths in other decimal digits: Arabic-Indic and mathematical.
#guard gives (formatInt 5 "١٠") "         5"
#guard gives (formatInt 5 "𝟙𝟚") "           5"

-- A NUL type: no type for a float, an unknown type otherwise.
#guard raises (formatInt 5 "\x00") "ValueError"
  "Unknown format code '\\x0' for object of type 'int'"
#guard gives (formatFloat 0x3FF8000000000000 "\x00") "1.5"  -- 1.5
#guard raises (formatStr "abc" "\x00") "ValueError"
  "Unknown format code '\\x0' for object of type 'str'"

-- A type outside '!' to '~' shows in hexadecimal.
#guard raises (formatInt 1 ".2 ") "ValueError"
  "Unknown format code '\\x20' for object of type 'int'"
#guard raises (formatInt 1 "é") "ValueError" "Unknown format code '\\xe9' for object of type 'int'"
#guard raises (formatInt 1 "😀") "ValueError"
  "Unknown format code '\\x1f600' for object of type 'int'"

-- Separators go with the types d e f g E G % F and none; '_' also with b o x X.
#guard raises (formatInt 1 ",c") "ValueError" "Cannot specify ',' with 'c'."
#guard raises (formatInt 1 ",x") "ValueError" "Cannot specify ',' with 'x'."
#guard gives (formatInt 11259375 "_x") "ab_cdef"
#guard raises (formatInt 1 "_n") "ValueError" "Cannot specify '_' with 'n'."
#guard raises (formatFloat 0x3FF0000000000000 ",n") "ValueError"  -- 1.0
  "Cannot specify ',' with 'n'."
#guard raises (formatStr "abc" ",") "ValueError" "Cannot specify ',' with 's'."
#guard raises (formatStr "abc" "_") "ValueError" "Cannot specify '_' with 's'."

-- Fills and alignments; a '0' after a fill is part of the width.
#guard gives (formatInt 1 "<<5") "1<<<<"
#guard gives (formatInt 1 "0<5") "10000"
#guard gives (formatInt (-1) "x=05") "-xxx1"
#guard gives (formatInt (-1) "=05") "-0001"
#guard gives (formatInt (-1) "<05") "-1000"
#guard gives (formatStr "ab" "05") "ab000"

-- Zero padding is grouped too, without a separator in front.
#guard gives (formatInt 1234 "08,") "0,001,234"
#guard gives (formatInt 1234 "09,") "0,001,234"
#guard gives (formatInt 1234 "010,") "00,001,234"
#guard gives (formatInt (-1234) "010_") "-0_001_234"
#guard gives (formatInt 1048575 "#012_x") "0x0_000f_ffff"

-- Prefixes and signs; 'X' makes the prefix upper case, and '#' adds none to decimals.
#guard gives (formatInt 255 "#_X") "0XFF"
#guard gives (formatInt (-255) "#o") "-0o377"
#guard gives (formatInt 5 "#b") "0b101"
#guard gives (formatInt (-5) "+d") "-5"
#guard gives (formatInt 5 " d") " 5"
#guard gives (formatInt 5 "#d") "5"

-- 'n' in the C locale: no grouping.
#guard gives (formatInt 1234567 "n") "1234567"
#guard gives (formatFloat 0x40934A0000000000 "n") "1234.5"  -- 1234.5

-- No precision and no 'z' for the int types; an unknown type.
#guard raises (formatInt 1 ".2") "ValueError" "Precision not allowed in integer format specifier"
#guard raises (formatInt 1 "z") "ValueError"
  "Negative zero coercion (z) not allowed in integer format specifier"
#guard raises (formatInt 1 "Q") "ValueError" "Unknown format code 'Q' for object of type 'int'"

-- 'c' is laid out like a number, without a sign or '#'.
#guard gives (formatInt 65 "05c") "0000A"
#guard gives (formatInt 65 "^5c") "  A  "
#guard gives (formatInt 0 "c") "\x00"
#guard gives (formatInt 1114111 "c") ((Char.ofNat 0x10FFFF).toString)
#guard raises (formatInt 1 "+c") "ValueError" "Sign not allowed with integer format specifier 'c'"
#guard raises (formatInt 1 "#c") "ValueError"
  "Alternate form (#) not allowed with integer format specifier 'c'"

-- 'c' first converts to a C long.
#guard raises (formatInt 9223372036854775808 "c") "OverflowError"
  "Python int too large to convert to C long"
#guard raises (formatInt (-9223372036854775808) "c") "OverflowError" "%c arg not in range(0x110000)"
#guard raises (formatInt (-1) "c") "OverflowError" "%c arg not in range(0x110000)"
#guard raises (formatInt 1114112 "c") "OverflowError" "%c arg not in range(0x110000)"

-- 'c' on a lone surrogate: not modelled.
#guard unmodelled (formatInt 55296 "c")

-- An int converts to a float, rounding ties to even, for e E f F g G %.
#guard gives (formatInt 9007199254740993 "f") "9007199254740992.000000"
#guard gives (formatInt 9007199254740995 "f") "9007199254740996.000000"
#guard gives (formatInt 7 "%") "700.000000%"
#guard gives (formatInt (2 ^ 1024 - 2 ^ 970 - 1) "e") "1.797693e+308"

-- The conversion overflows from 2^1024 - 2^970 on.
#guard raises (formatInt (2 ^ 1024) "e") "OverflowError" "int too large to convert to float"
#guard raises (formatInt (2 ^ 1024 - 2 ^ 970) "f") "OverflowError"
  "int too large to convert to float"

-- 'z' is allowed once an int formats as a float.
#guard gives (formatInt 0 "z.1f") "0.0"

-- 'e' has 6 digits past the point by default.
#guard gives (formatFloat 0x3FF8000000000000 "e") "1.500000e+00"  -- 1.5
#guard gives (formatFloat 0x0000000000000000 "e") "0.000000e+00"  -- 0.0
#guard gives (formatFloat 0x0000000000000001 "e") "4.940656e-324"  -- 5e-324

-- Ties round to even; 2.675 and 9.995 are below the tie.
#guard gives (formatFloat 0x3FC0000000000000 ".2f") "0.12"  -- 0.125
#guard gives (formatFloat 0x3FD8000000000000 ".2f") "0.38"  -- 0.375
#guard gives (formatFloat 0x4004000000000000 ".0f") "2"  -- 2.5
#guard gives (formatFloat 0x400C000000000000 ".0f") "4"  -- 3.5
#guard gives (formatFloat 0x3FE0000000000000 ".0f") "0"  -- 0.5
#guard gives (formatFloat 0x4005666666666666 ".2f") "2.67"  -- 2.675
#guard gives (formatFloat 0x4023FD70A3D70A3D ".2f") "9.99"  -- 9.995

-- Digits of the exact binary value.
#guard gives (formatFloat 0x3FB999999999999A ".30f") "0.100000000000000005551115123126"  -- 0.1
#guard gives (formatFloat 0x7E37E43C8800759C ".3e") "1.000e+300"  -- 1e+300
#guard gives (formatFloat 0x4480F0CF064DD592 "f") "10000000000000000000000.000000"  -- 1e+22

-- More digits than any float has.
#guard gives (formatFloat 0x3FE0000000000000 ".1100e")  -- 0.5
  ("5." ++ String.ofList (List.replicate 1100 '0') ++ "e-01")

-- 'g' without '#' drops trailing zeros, so a precision over 2 ^ 24 gives a short string.
#guard gives (formatFloat 0x3FF0000000000000 ".16777217g") "1"  -- 1.0
#guard gives (formatFloat 0x3FB999999999999A ".2000g")  -- 0.1
  "0.1000000000000000055511151231257827021181583404541015625"
#guard gives (formatFloat 0x3FB999999999999A ".16777217")  -- 0.1
  "0.1000000000000000055511151231257827021181583404541015625"

