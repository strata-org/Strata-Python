class Add:
    def __init__(self, v):
        self.v = v
    def __add__(self, other):
        events.append("Add.__add__")
        if isinstance(other, int):
            return Add(self.v + other)
        return NotImplemented
    def __radd__(self, other):
        events.append("Add.__radd__")
        if isinstance(other, int):
            return Add(other + self.v)
        return NotImplemented
    def __repr__(self):
        return f"Add({self.v})"
class Hint:
    def __init__(self, n):
        self.n = n
    def __length_hint__(self):
        events.append("Hint.__length_hint__")
        return self.n
    def __iter__(self):
        return iter(range(self.n))
class Idx:
    def __init__(self, v):
        self.v = v
    def __index__(self):
        events.append("Idx.__index__")
        return self.v
class It:
    def __init__(self, items):
        self.items = list(items)
        self.i = 0
    def __iter__(self):
        events.append("It.__iter__")
        return self
    def __next__(self):
        if self.i >= len(self.items):
            events.append("It.stop")
            raise StopIteration
        self.i += 1
        return self.items[self.i - 1]
class N:
    def __init__(self, v):
        self.v = v
    def __eq__(self, other):
        events.append("N.__eq__")
        return isinstance(other, N) and self.v == other.v
    def __lt__(self, other):
        events.append("N.__lt__")
        if not isinstance(other, N):
            return NotImplemented
        return self.v < other.v
    def __gt__(self, other):
        events.append("N.__gt__")
        if not isinstance(other, N):
            return NotImplemented
        return self.v > other.v
    def __hash__(self):
        return self.v
    def __repr__(self):
        return f"N({self.v})"
class Sized:
    def __init__(self, n):
        self.n = n
    def __len__(self):
        events.append("Sized.__len__")
        return self.n
    def __iter__(self):
        return iter(range(self.n))
