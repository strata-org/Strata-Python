        return self.v < other.v
    def __gt__(self, other):
        events.append("N.__gt__")
        if not isinstance(other, N):
            return NotImplemented
        return self.v > other.v
    def __hash__(self):
        return self.v
    def __repr__(self):
        return f"N({self.v})"
class Sized:
    def __init__(self, n):
        self.n = n
    def __len__(self):
        events.append("Sized.__len__")
        return self.n
    def __iter__(self):
        return iter(range(self.n))
