module

meta import StrataPythonTest.Util.Python -- shake: keep

/-! ## The library's binding signatures are CPython 3.12's

`StrataPython/Dyn/Sem/Library/Signatures.lean` and the test program
`StrataPythonTest/Dyn/dyn_tests/lib_signatures.py` are generated by
`StrataPythonTest/Dyn/Sem/Library/gen_signatures.py` from CPython 3.12's argument errors. This
test runs the generator again with `--check`, and fails if either file differs from its output.
It skips when the Python it finds is not 3.12. -/

namespace StrataPython.SignaturesTest

meta section

def generator : System.FilePath := "StrataPythonTest/Dyn/Sem/Library/gen_signatures.py"

def main : IO Unit := do
  withPython fun pythonCmd => do
    if (← getPython3Version pythonCmd.toString) != some 12 then
      IO.println s!"skipped: {pythonCmd} is not CPython 3.12"
      return
    let out ← IO.Process.output
      { cmd := pythonCmd.toString, args := #[generator.toString, "--check"] }
    if out.exitCode != 0 then
      throw <| .userError s!"{generator} --check failed:\n{out.stderr}"

end

end StrataPython.SignaturesTest

#eval StrataPython.SignaturesTest.main
